---

import type { Tool } from '../data/tools';
import Icon from './Icon.astro';

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.slug}`}
  class="card-hover group relative flex min-h-[200px] flex-col overflow-hidden p-5 xs:p-4"
  aria-label={tool.name}
>
  <div class="absolute -right-8 -top-8 h-24 w-24 rounded-full bg-brand-500/5 blur-2xl transition-opacity group-hover:opacity-100 dark:bg-brand-500/10"></div>

  <div class="mb-3 flex items-center justify-between">
    <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-surface-light-alt text-brand-500 transition-all group-hover:scale-110 group-hover:bg-brand-50 dark:bg-surface-dark-alt dark:text-brand-400 dark:group-hover:bg-brand-900/20">
      <Icon name={tool.icon} class="h-6 w-6" />
    </span>
    <span class="badge-neutral">{tool.category}</span>
  </div>

  <h3 class="text-h4 font-semibold leading-tight transition-colors group-hover:text-brand-600 dark:group-hover:text-brand-300">
    {tool.shortName}
  </h3>

  <p class="mt-2 flex-1 text-small text-txt-muted leading-relaxed">
    {tool.description}
  </p>

  <div class="mt-4 flex items-center gap-1.5 text-small font-medium text-brand-600 dark:text-brand-300">
    <span>Use tool</span>
    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
  </div>
</a>
