---

export interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  center?: boolean;
}

const { title, subtitle, eyebrow, center = true } = Astro.props;
---

<div class={`mb-12 ${center ? 'text-center' : ''}`}>
  {eyebrow && (
    <div class={`mb-3 ${center ? 'flex justify-center' : ''}`}>
      <span class="badge-brand">{eyebrow}</span>
    </div>
  )}
  <h2 class="text-h2 font-bold tracking-tight xs:text-h3">
    {center ? <span class="text-gradient">{title}</span> : title}
  </h2>
  {subtitle && (
    <p class={`mt-3 text-body-lg text-txt-muted ${center ? 'mx-auto max-w-2xl' : ''} xs:text-body`}>
      {subtitle}
    </p>
  )}
</div>
