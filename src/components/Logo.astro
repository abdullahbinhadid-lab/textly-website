---

export interface Props {
  size?: 'sm' | 'md' | 'lg';
  showText?: boolean;
}

const { size = 'md', showText = true } = Astro.props;

const sizeClasses = {
  sm: 'w-8 h-8',
  md: 'w-10 h-10',
  lg: 'w-14 h-14',
};

const textSizeClasses = {
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-3xl',
};
---

<a href="/" class="flex items-center gap-2.5 font-bold transition-opacity hover:opacity-90" aria-label="Textly home">
  <div class={`${sizeClasses[size]} flex shrink-0 items-center justify-center rounded-xl bg-brand-gradient shadow-glow transition-transform hover:scale-105`}>
    <svg class="w-1/2 h-1/2 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 7V5a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2" />
      <path d="M9 20h6" />
      <path d="M12 4v16" />
    </svg>
  </div>
  {showText && (
    <span class={`${textSizeClasses[size]} text-gradient font-extrabold tracking-tight`}>
      Textly
    </span>
  )}
</a>
