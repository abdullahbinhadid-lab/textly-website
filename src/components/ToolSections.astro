---
import { toolContent } from '../data/tool-content';
import Icon from './Icon.astro';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const content = toolContent[slug];

if (!content) {
  console.warn(`No tool content found for slug: ${slug}`);
}
---

{content && (
<!-- Section 1: Features -->
<section class="mt-16 sm:mt-20">
  <div class="text-center mb-10">
    <div class="mb-3 flex justify-center">
      <span class="badge-brand">Features</span>
    </div>
    <h2 class="text-h2 font-bold tracking-tight xs:text-h3">
      <span class="text-gradient">Everything You Need</span>
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-body-lg text-txt-muted xs:text-body">
      Powerful features designed to make your text work easier and faster.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {content.features.map((feature) => (
      <div class="card-feature group p-6">
        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-surface-light-alt text-brand-500 transition-all group-hover:scale-110 group-hover:bg-brand-50 dark:bg-surface-dark-alt dark:text-brand-400 dark:group-hover:bg-brand-900/20">
          <Icon name={feature.icon} class="h-6 w-6" />
        </div>
        <h3 class="text-body font-semibold mb-2">{feature.title}</h3>
        <p class="text-small text-txt-muted leading-relaxed">{feature.description}</p>
      </div>
    ))}
  </div>
</section>
)
}

{content && (
<!-- Section 2: How It Works -->
<section class="mt-16 sm:mt-20">
  <div class="text-center mb-10">
    <div class="mb-3 flex justify-center">
      <span class="badge-brand">How It Works</span>
    </div>
    <h2 class="text-h2 font-bold tracking-tight xs:text-h3">
      <span class="text-gradient">Simple as 1-2-3</span>
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-body-lg text-txt-muted xs:text-body">
      No learning curve. Get results in seconds with our intuitive workflow.
    </p>
  </div>

  <div class="relative">
    <div class="absolute left-1/2 top-0 hidden h-full w-px -translate-x-1/2 bg-gradient-to-b from-brand-300 via-brand-400 to-transparent lg:block dark:from-brand-700 dark:via-brand-600"></div>

    <div class="space-y-6 lg:space-y-0">
      {content.howItWorks.map((step, index) => (
        <div class={`relative flex flex-col gap-4 lg:flex-row lg:items-center ${index % 2 === 1 ? 'lg:flex-row-reverse' : ''}`}>
          <div class="flex-1 lg:px-8">
            <div class={`card p-6 ${index % 2 === 0 ? 'lg:text-right' : ''}`}>
              <div class={`mb-3 flex items-center gap-3 ${index % 2 === 0 ? 'lg:justify-end' : ''}`}>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-gradient text-white font-bold text-small shadow-glow">
                  {index + 1}
                </span>
                <h3 class="text-body font-semibold">{step.title}</h3>
              </div>
              <p class="text-small text-txt-muted leading-relaxed">{step.description}</p>
            </div>
          </div>

          <div class="hidden lg:flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-brand-500 ring-4 ring-brand-100 dark:ring-brand-900/40 z-10"></div>

          <div class="hidden flex-1 lg:block"></div>
        </div>
      ))}
    </div>
  </div>
</section>
)
}

{content && (
<!-- Section 3: Use Cases -->
<section class="mt-16 sm:mt-20">
  <div class="text-center mb-10">
    <div class="mb-3 flex justify-center">
      <span class="badge-brand">Use Cases</span>
    </div>
    <h2 class="text-h2 font-bold tracking-tight xs:text-h3">
      <span class="text-gradient">Who Is It For?</span>
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-body-lg text-txt-muted xs:text-body">
      Designed for professionals, students, and creators across industries.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {content.useCases.map((useCase) => (
      <div class="card-hover group flex items-start gap-4 p-6">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-soft transition-transform group-hover:scale-110">
          <Icon name={useCase.icon} class="h-6 w-6" />
        </div>
        <div class="flex-1">
          <h3 class="text-body font-semibold mb-1">{useCase.title}</h3>
          <p class="text-small text-txt-muted leading-relaxed">{useCase.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
)
}

{content && (
<!-- Section 4: Benefits -->
<section class="mt-16 sm:mt-20">
  <div class="relative overflow-hidden rounded-3xl border border-border-light bg-surface-light/50 p-8 backdrop-blur-sm sm:p-12 dark:border-border-dark dark:bg-surface-dark/50">
    <div class="absolute -top-20 -right-20 h-60 w-60 rounded-full bg-brand-500/10 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 h-60 w-60 rounded-full bg-cyan-500/10 blur-3xl"></div>

    <div class="relative z-10">
      <div class="text-center mb-10">
        <div class="mb-3 flex justify-center">
          <span class="badge-brand">Benefits</span>
        </div>
        <h2 class="text-h2 font-bold tracking-tight xs:text-h3">
          <span class="text-gradient">Why Choose This Tool?</span>
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-body-lg text-txt-muted xs:text-body">
          Real advantages that save you time and protect your privacy.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {content.benefits.map((benefit) => (
          <div class="flex items-start gap-4">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600 dark:bg-brand-900/30 dark:text-brand-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div>
              <h3 class="text-body font-semibold mb-1">{benefit.title}</h3>
              <p class="text-small text-txt-muted leading-relaxed">{benefit.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
)
}

{content && (
<!-- Section 5: FAQ -->
<section class="mt-16 sm:mt-20">
  <div class="text-center mb-10">
    <div class="mb-3 flex justify-center">
      <span class="badge-brand">FAQ</span>
    </div>
    <h2 class="text-h2 font-bold tracking-tight xs:text-h3">
      <span class="text-gradient">Frequently Asked Questions</span>
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-body-lg text-txt-muted xs:text-body">
      Everything you need to know about this tool.
    </p>
  </div>

  <div class="mx-auto max-w-3xl space-y-3">
    {content.faqs.map((item, index) => (
      <details class="card group overflow-hidden transition-all hover:shadow-soft open:shadow-soft open:border-brand-300 dark:open:border-brand-700" id={`faq-${index}`}>
        <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-semibold text-txt-light dark:text-txt-dark list-none">
          <span class="text-body">{item.question}</span>
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-surface-light-alt text-brand-500 transition-all group-open:bg-brand-500 group-open:text-white dark:bg-surface-dark-alt">
            <svg class="h-4 w-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </summary>
        <div class="px-5 pb-5 text-small text-txt-muted leading-relaxed">
          {item.answer}
        </div>
      </details>
    ))}
  </div>
</section>
)
}

{content && (
<!-- Section 6: Privacy & CTA -->
<section class="mt-16 sm:mt-20">
  <div class="relative overflow-hidden rounded-3xl bg-brand-gradient-animated p-10 text-center shadow-large sm:p-16 xs:p-8">
    <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
    <div class="absolute -top-20 -right-20 h-60 w-60 rounded-full bg-white/10 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 h-60 w-60 rounded-full bg-cyan-300/20 blur-3xl"></div>

    <div class="relative z-10">
      <div class="mb-6 flex justify-center">
        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-sm">
          <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
      </div>

      <h2 class="text-h2 font-bold text-white xs:text-h3">100% Private. 100% Free.</h2>
      <p class="mx-auto mt-4 max-w-2xl text-body-lg text-white/90 xs:text-body">
        This tool runs entirely in your browser. Your text is never uploaded to any server. No signup, no tracking, no hidden costs — forever.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/tools" class="inline-flex items-center justify-center gap-2 rounded-xl bg-white px-7 py-3.5 font-semibold text-brand-600 shadow-medium transition-all hover:scale-[1.03] hover:shadow-glow active:scale-[0.98] xs:w-full">
          Explore All Tools
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-small text-white/80">
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          No Signup
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          No Uploads
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          No Tracking
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Free Forever
        </div>
      </div>
    </div>
  </div>
</section>
)
}

<style>
  details summary::-webkit-details-marker { display: none; }
  details summary::marker { content: ''; }
</style>
