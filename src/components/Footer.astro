---

import Logo from './Logo.astro';
import { tools } from '../data/tools';

const year = new Date().getFullYear();

const footerLinks = {
  Tools: tools.slice(0, 8).map((t) => ({ href: `/tools/${t.slug}`, label: t.shortName })),
  Company: [
    { href: '/about', label: 'About Us' },
    { href: '/contact', label: 'Contact' },
    { href: '/blog', label: 'Blog' },
    { href: '/faq', label: 'FAQ' },
    { href: '/donate', label: 'Donate' },
  ],
  Legal: [
    { href: '/privacy', label: 'Privacy Policy' },
    { href: '/terms', label: 'Terms of Service' },
    { href: '/cookie-policy', label: 'Cookie Policy' },
  ],
};
---

<footer class="relative z-10 mt-20 border-t border-white/10 bg-white/40 backdrop-blur-sm dark:bg-surface-dark/40 dark:border-white/5">
  <div class="container-page py-14">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-brand-500/30 to-transparent"></div>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <Logo size="md" />
        <p class="text-small text-txt-muted max-w-xs">
          33 free online text tools. 100% client-side, privacy-first. No signup required.
        </p>
        <div class="space-y-1 text-tiny">
          <a href="mailto:info@toolly.site" class="block text-txt-muted transition-colors hover:text-brand-600 dark:hover:text-brand-300">info@toolly.site</a>
          <a href="mailto:tool@toolly.site" class="block text-txt-muted transition-colors hover:text-brand-600 dark:hover:text-brand-300">tool@toolly.site</a>
        </div>
        <div class="flex gap-3">
          <a href="https://twitter.com/toolly_site" class="flex h-9 w-9 items-center justify-center rounded-lg border border-border-light text-txt-muted transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-border-dark dark:hover:text-brand-300" aria-label="Twitter">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://github.com/toolly-site" class="flex h-9 w-9 items-center justify-center rounded-lg border border-border-light text-txt-muted transition-colors hover:border-brand-400 hover:text-brand-600 dark:border-border-dark dark:hover:text-brand-300" aria-label="GitHub">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </div>

      {Object.entries(footerLinks).map(([title, links]) => (
        <div>
          <h3 class="mb-4 text-small font-semibold uppercase tracking-wider text-txt-muted">{title}</h3>
          <ul class="space-y-2.5">
            {links.map((link) => (
              <li>
                <a href={link.href} class="text-small text-txt-light/70 transition-colors hover:text-brand-600 dark:text-txt-dark/70 dark:hover:text-brand-300">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 sm:flex-row dark:border-white/5">
      <p class="text-tiny text-txt-muted">
        &copy; {year} Textly. All rights reserved. Made with care for privacy.
      </p>
      <p class="text-tiny text-txt-muted">
        100% Client-Side &middot; No Data Uploaded &middot; Free Forever
      </p>
    </div>
  </div>
</footer>
