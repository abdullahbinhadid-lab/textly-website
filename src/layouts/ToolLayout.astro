---

import BaseLayout from './BaseLayout.astro';
import { getTool, getRelatedTools } from '../data/tools';
import ToolCard from '../components/ToolCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';

export interface Props {
  slug: string;
}

const { slug } = Astro.props;
const tool = getTool(slug);

if (!tool) {
  throw new Error(`Tool not found: ${slug}`);
}

const related = getRelatedTools(slug, 3);

const toolURL = new URL(`/tools/${tool.slug}`, Astro.site);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: tool.name,
    description: tool.longDescription,
    url: toolURL.href,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web-based)',
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
    },
    featureList: tool.keywords,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: new URL('/tools', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: tool.shortName, item: toolURL.href },
    ],
  },
];
---

<BaseLayout title={tool.name} description={tool.longDescription} canonical={`/tools/${tool.slug}`} keywords={tool.keywords} schema={schema} showAds={false}
  contactTitle="Found a bug? Have a suggestion?"
  contactDescription={`Spotted an issue with ${tool.shortName} or have an idea to improve it? Let us know — we read every message.`}
  contactButtonText="Send Feedback"
>
  <div class="container-page py-8 sm:py-12">
    <nav class="mb-6 flex items-center gap-2 text-small text-txt-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-300">Home</a>
      <span>/</span>
      <a href="/tools" class="hover:text-brand-600 dark:hover:text-brand-300">Tools</a>
      <span>/</span>
      <span class="text-txt-light dark:text-txt-dark">{tool.shortName}</span>
    </nav>

    <div class="mb-8 flex items-start gap-4">
      <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-gradient text-white shadow-glow">
        <Icon name={tool.icon} class="h-7 w-7" />
      </div>
      <div class="flex-1">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <h1 class="text-h2 font-bold tracking-tight xs:text-h3">{tool.name}</h1>
          <span class="badge-success">Free</span>
          <span class="badge-neutral">{tool.category}</span>
        </div>
        <p class="text-body text-txt-muted xs:text-small">{tool.description}</p>
      </div>
    </div>

    <div class="mb-6 flex items-center gap-2 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-small text-brand-700 dark:border-brand-800 dark:bg-brand-900/20 dark:text-brand-300">
      <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <span><strong>Privacy-first:</strong> All processing happens in your browser. Your text is never uploaded to any server.</span>
    </div>

    <slot />

    <div class="ad-slot mt-8">
      <span>Advertisement</span>
    </div>

    {related.length > 0 && (
      <section class="mt-16">
        <SectionHeading title="Related Tools" center={false} />
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((t) => (
            <ToolCard tool={t} />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
