---

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Recommend a Tool — Textly"
  description="Suggest a new text tool for Textly. We'd love to hear your ideas for new free utilities."
  canonical="/recommend-a-tool"
  hideContactForm={true}
>
  <section class="relative overflow-hidden pt-16 pb-12 sm:pt-24 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute left-[12%] top-[15%] h-72 w-72 rounded-full bg-brand-500/15 blur-3xl animate-float dark:bg-brand-500/8"></div>
      <div class="absolute right-[10%] top-[20%] h-64 w-64 rounded-full bg-cyan-500/15 blur-3xl animate-float-slow dark:bg-cyan-500/8"></div>
    </div>
    <div class="container-narrow relative z-10 text-center">
      <div class="mb-4 flex justify-center">
        <span class="badge-brand">Suggest a Tool</span>
      </div>
      <h1 class="text-h1 font-extrabold tracking-tight xs:text-[2rem]">
        <span class="text-gradient">Recommend a Tool</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-body-lg text-txt-muted xs:text-small">
        Have an idea for a text tool that would make your life easier? Let us know! We're always expanding our collection of free tools.
      </p>
    </div>
  </section>

  <div class="container-narrow pb-16">
    <form id="recommend-form" class="card p-6 sm:p-8 space-y-5">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="block text-small font-medium mb-2">Your Name</label>
          <input type="text" id="name" name="name" required class="tool-input" style="min-height: auto;" placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="block text-small font-medium mb-2">Email</label>
          <input type="email" id="email" name="email" required class="tool-input" style="min-height: auto;" placeholder="you@example.com" />
        </div>
      </div>

      <div>
        <label for="tool-name" class="block text-small font-medium mb-2">Tool Name</label>
        <input type="text" id="tool-name" name="tool-name" required class="tool-input" style="min-height: auto;" placeholder="e.g. JSON Formatter, Markdown Converter..." />
      </div>

      <div>
        <label for="description" class="block text-small font-medium mb-2">What should the tool do?</label>
        <textarea id="description" name="message" required rows="5" class="tool-textarea" placeholder="Describe what the tool does, what problem it solves, and any features you'd like to see..."></textarea>
      </div>

      <button type="submit" class="btn-primary w-full">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        Submit Recommendation
      </button>

      <div id="form-success" class="hidden rounded-xl border border-green-300 bg-green-50 p-4 text-small text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-300">
        <strong>Thank you for your suggestion!</strong> <span id="success-text">Your recommendation has been sent. We'll review it and get back to you soon!</span>
      </div>

      <div id="form-error" class="hidden rounded-xl border border-red-300 bg-red-50 p-4 text-small text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-300">
        <strong>Oops!</strong> <span id="error-text">Something went wrong. Please try again or email us directly.</span>
      </div>

      <p class="text-center text-tiny text-txt-muted">
        Or email us directly at
        <a href="mailto:tool@toolly.site" class="font-medium text-brand-600 hover:underline dark:text-brand-300">tool@toolly.site</a>
      </p>
    </form>
  </div>

  <div class="container-narrow pb-16">
    <div class="card p-6 text-center">
      <h2 class="text-h4 font-bold mb-2">Want to explore our existing tools?</h2>
      <p class="text-small text-txt-muted mb-4">Browse all 33 free text tools or check out our guides.</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href="/tools" class="btn-primary px-5 py-2.5 text-small">Browse All Tools</a>
        <a href="/guides" class="btn-secondary px-5 py-2.5 text-small">View Guides</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('recommend-form');
      if (!form) return;
      var success = document.getElementById('form-success');
      var errorEl = document.getElementById('form-error');
      var successText = document.getElementById('success-text');
      var errorText = document.getElementById('error-text');
      var submitBtn = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        submitBtn.disabled = true;
        success.classList.add('hidden');
        errorEl.classList.add('hidden');

        var data = {};
        new FormData(form).forEach(function (val, key) { data[key] = val; });
        data.form_type = 'recommend';
        data.page_url = window.location.href;

        fetch('/send-mail.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (result.success) {
            successText.textContent = result.message;
            success.classList.remove('hidden');
            form.reset();
            submitBtn.style.display = 'none';
          } else {
            errorText.textContent = result.message || 'Something went wrong.';
            errorEl.classList.remove('hidden');
          }
        })
        .catch(function () {
          errorText.textContent = 'Could not connect to the server. Please email us directly at tool@toolly.site';
          errorEl.classList.remove('hidden');
        })
        .finally(function () {
          submitBtn.disabled = false;
        });
      });
    })();
  </script>
</BaseLayout>
