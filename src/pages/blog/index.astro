---

import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import { blogPosts } from '../../data/blog-posts';
import { getPublishedScheduledPosts } from '../../data/scheduled-posts';

const scheduledPosts = getPublishedScheduledPosts();
const posts = [...blogPosts, ...scheduledPosts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const postsPerPage = 30;
const totalPages = Math.ceil(posts.length / postsPerPage);

const tags = ['All', ...new Set(posts.map((p) => p.tag))];

const formatDate = (dateStr: string) => {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Textly Blog',
  url: new URL('/blog', Astro.site).href,
  description: 'Articles about text tools, privacy, writing tips, and web technology from the Textly team.',
  publisher: {
    '@type': 'Organization',
    name: 'Textly',
    url: new URL('/', Astro.site).href,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', Astro.site).href },
  ],
};
---

<BaseLayout
  title="Blog — Textly"
  description="Articles about text tools, privacy, writing tips, and web technology from the Textly team."
  canonical="/blog"
  schema={[blogSchema, breadcrumbSchema]}
  hideContactForm={true}
>
  <!-- Hero -->
  <section class="relative overflow-hidden pt-20 pb-12">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-border-light bg-surface-light/60 px-4 py-1.5 text-tiny font-semibold text-txt-muted backdrop-blur-sm dark:border-border-dark dark:bg-surface-dark/60">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-brand-500"></span>
          </span>
          Textly Blog
        </div>
        <h1 class="text-h1 font-bold tracking-tight xs:text-h2">
          Insights, guides &
          <span class="text-gradient"> deep dives</span>
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-body-lg text-txt-muted xs:text-body">
          Tips, guides, and insights about text tools, privacy, and writing from the Textly team.
        </p>
      </div>
    </div>
  </section>


  <!-- Tag filter + Grid -->
  <section class="container-page pb-16">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-h4 font-bold">All Articles</h2>
      <span class="text-tiny text-txt-muted" id="post-count">{posts.length} posts</span>
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      {tags.map((tag, i) => (
        <button
          class={`rounded-full px-4 py-1.5 text-tiny font-semibold transition-all ${i === 0 ? 'bg-brand-gradient text-white shadow-soft' : 'border border-border-light bg-surface-light text-txt-muted hover:border-brand-400 hover:text-brand-600 dark:border-border-dark dark:bg-surface-dark dark:hover:text-brand-300'}`}
          data-tag={tag}
        >
          {tag}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" id="posts-grid">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}`}
          class="card-hover group relative flex flex-col overflow-hidden rounded-2xl transition-all duration-300 hover:-translate-y-2 hover:shadow-large hover:border-brand-400 dark:hover:border-brand-600"
          data-post-tag={post.tag}
        >
          <!-- Gradient glow on hover -->
          <div class="pointer-events-none absolute -inset-px rounded-2xl opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: linear-gradient(135deg, rgba(124,58,237,0.15), rgba(6,182,212,0.1), rgba(236,72,153,0.1)); filter: blur(12px); z-index: -1;"></div>

          <div class={`relative flex aspect-video items-center justify-center bg-gradient-to-br ${post.gradient} overflow-hidden`}>
            {post.image ? (
              <img
                src={post.image}
                alt=""
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 70% 30%, rgba(255,255,255,0.3) 0%, transparent 50%);"></div>
            )}
            <!-- Shine sweep on hover -->
            <div class="pointer-events-none absolute inset-0 -translate-x-full skew-x-[-20deg] bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-700 group-hover:translate-x-full"></div>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <div class="mb-2 flex items-center gap-2">
              <span class="badge-brand">{post.tag}</span>
              <span class="text-tiny text-txt-muted">{post.readTime} read</span>
            </div>
            <h3 class="text-h4 font-semibold leading-tight transition-colors group-hover:text-brand-600 dark:group-hover:text-brand-300">
              {post.title}
            </h3>
            <p class="mt-2 flex-1 text-small text-txt-muted leading-relaxed">
              {post.excerpt}
            </p>
            <div class="mt-4 flex items-center justify-between text-tiny text-txt-muted">
              <span>{formatDate(post.date)}</span>
              <span class="flex items-center gap-1 font-semibold text-brand-600 dark:text-brand-300 opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100">
                Read
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Pagination -->
    <div id="pagination" class="mt-12 flex items-center justify-center gap-2"></div>
  </section>

  <CTA
    title="Found something interesting?"
    description="Put what you learned into practice with our 33 free, privacy-first text tools."
    buttonText="Explore All Tools"
    buttonHref="/tools"
  />
</BaseLayout>

<script is:inline define:vars={{ postsPerPage, totalPages }}>
  let currentPage = 1;
  let currentTag = 'All';

  const grid = document.getElementById('posts-grid');
  const pagination = document.getElementById('pagination');
  const postCount = document.getElementById('post-count');
  const allCards = Array.from(document.querySelectorAll('[data-post-tag]'));

  function getFilteredCards() {
    if (currentTag === 'All') return allCards;
    return allCards.filter((c) => c.getAttribute('data-post-tag') === currentTag);
  }

  function renderPage() {
    const filtered = getFilteredCards();
    const filteredTotalPages = Math.ceil(filtered.length / postsPerPage);
    const page = Math.min(currentPage, filteredTotalPages || 1);
    const start = (page - 1) * postsPerPage;
    const end = start + postsPerPage;

    allCards.forEach((c) => (c.style.display = 'none'));
    filtered.slice(start, end).forEach((c) => (c.style.display = ''));

    if (postCount) postCount.textContent = filtered.length + ' posts';

    renderPagination(filteredTotalPages, page);
  }

  function renderPagination(totalPgs, page) {
    if (!pagination) return;
    if (totalPgs <= 1) {
      pagination.innerHTML = '';
      return;
    }

    let html = '';

    // Prev button
    if (page > 1) {
      html += `<button data-page="${page - 1}" class="flex h-10 w-10 items-center justify-center rounded-lg border border-border-light text-txt-muted transition-all hover:border-brand-400 hover:text-brand-600 dark:border-border-dark dark:hover:text-brand-300" aria-label="Previous page"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg></button>`;
    }

    // Page numbers
    for (let i = 1; i <= totalPgs; i++) {
      const isActive = i === page;
      html += `<button data-page="${i}" class="flex h-10 min-w-10 items-center justify-center rounded-lg px-3 text-small font-semibold transition-all ${isActive ? 'bg-brand-gradient text-white shadow-soft' : 'border border-border-light text-txt-muted hover:border-brand-400 hover:text-brand-600 dark:border-border-dark dark:bg-surface-dark dark:hover:text-brand-300'}">${i}</button>`;
    }

    // Next button
    if (page < totalPgs) {
      html += `<button data-page="${page + 1}" class="flex h-10 w-10 items-center justify-center rounded-lg border border-border-light text-txt-muted transition-all hover:border-brand-400 hover:text-brand-600 dark:border-border-dark dark:hover:text-brand-300" aria-label="Next page"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></button>`;
    }

    pagination.innerHTML = html;

    pagination.querySelectorAll('[data-page]').forEach((btn) => {
      btn.addEventListener('click', () => {
        currentPage = parseInt(btn.getAttribute('data-page'));
        renderPage();
        window.scrollTo({ top: grid.offsetTop - 80, behavior: 'smooth' });
      });
    });
  }

  // Tag filtering
  document.querySelectorAll('[data-tag]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = btn.getAttribute('data-tag');
      currentTag = tag;
      currentPage = 1;

      document.querySelectorAll('[data-tag]').forEach((b) => {
        b.classList.remove('bg-brand-gradient', 'text-white', 'shadow-soft');
        b.classList.add('border', 'border-border-light', 'bg-surface-light', 'text-txt-muted', 'dark:border-border-dark', 'dark:bg-surface-dark');
      });
      btn.classList.add('bg-brand-gradient', 'text-white', 'shadow-soft');
      btn.classList.remove('border', 'border-border-light', 'bg-surface-light', 'text-txt-muted', 'dark:border-border-dark', 'dark:bg-surface-dark');

      renderPage();
    });
  });

  // Initial render
  renderPage();
</script>
