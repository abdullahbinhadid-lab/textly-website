---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="speech-to-text">
  <div class="stt-tool space-y-4 sm:space-y-5">
    <!-- Main Glass Card -->
    <div class="card-glass relative overflow-hidden p-4 sm:p-6">
      <div class="pointer-events-none absolute -top-24 -right-24 h-48 w-48 rounded-full bg-brand-500/10 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 h-48 w-48 rounded-full bg-accent-500/10 blur-3xl"></div>

      <div class="relative z-10 space-y-4">
        <!-- Language Selection -->
        <div class="flex items-center gap-3">
          <div class="relative flex-1">
            <select id="stt-lang" class="tool-select w-full appearance-none pr-10 text-small" aria-label="Select recognition language">
              <option value="en-US">English (US)</option>
              <option value="en-GB">English (UK)</option>
              <option value="es-ES">Spanish (Spain)</option>
              <option value="es-MX">Spanish (Mexico)</option>
              <option value="fr-FR">French</option>
              <option value="de-DE">German</option>
              <option value="it-IT">Italian</option>
              <option value="pt-BR">Portuguese (Brazil)</option>
              <option value="pt-PT">Portuguese (Portugal)</option>
              <option value="ru-RU">Russian</option>
              <option value="ja-JP">Japanese</option>
              <option value="ko-KR">Korean</option>
              <option value="zh-CN">Chinese (Simplified)</option>
              <option value="zh-TW">Chinese (Traditional)</option>
              <option value="ar-SA">Arabic</option>
              <option value="hi-IN">Hindi</option>
              <option value="tr-TR">Turkish</option>
              <option value="nl-NL">Dutch</option>
              <option value="pl-PL">Polish</option>
              <option value="sv-SE">Swedish</option>
            </select>
            <svg class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 text-txt-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </div>
          <!-- Continuous Mode Toggle -->
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-border-light bg-white/40 px-3 py-2.5 text-tiny font-semibold backdrop-blur-sm dark:border-border-dark dark:bg-white/5" title="Keep recognition running without auto-stopping">
            <input type="checkbox" id="stt-continuous" class="stt-checkbox h-4 w-4 rounded accent-brand-500" checked />
            <span class="text-txt-muted">Continuous</span>
          </label>
        </div>

        <!-- Mic Button & Status -->
        <div class="flex flex-col items-center justify-center py-4">
          <button id="stt-mic-btn" class="stt-mic-btn group relative flex h-20 w-20 items-center justify-center rounded-full bg-brand-gradient text-white shadow-glow transition-all hover:scale-105 active:scale-95" aria-label="Start dictation">
            <div class="absolute inset-0 rounded-full bg-brand-500/30 opacity-0 transition-opacity group-hover:opacity-100 blur-xl"></div>
            <svg class="relative h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><path d="M12 19v3"/></svg>
          </button>
          <p id="stt-mic-label" class="mt-3 text-small font-semibold text-txt-light dark:text-txt-dark">Click to start dictation</p>
          <p class="mt-1 text-tiny text-txt-muted">
            <kbd class="rounded bg-surface-light-alt px-1.5 py-0.5 text-tiny font-mono dark:bg-surface-dark-alt">Ctrl+Space</kbd> to start/stop
          </p>
        </div>

        <!-- Recording Timer -->
        <div id="stt-timer-bar" class="hidden items-center justify-center gap-3 rounded-xl border border-brand-200 bg-brand-50/50 px-4 py-2.5 dark:border-brand-800 dark:bg-brand-900/20">
          <div class="flex items-center gap-2">
            <div class="h-2.5 w-2.5 animate-pulse rounded-full bg-red-500"></div>
            <span class="text-small font-semibold text-red-600 dark:text-red-400">Recording</span>
          </div>
          <span id="stt-timer" class="font-mono text-small font-bold text-brand-600 dark:text-brand-300">00:00</span>
        </div>

        <!-- Interim Results Preview -->
        <div id="stt-interim-container" class="hidden rounded-xl border border-border-light bg-surface-light-alt/40 px-4 py-3 dark:border-border-dark dark:bg-surface-dark-alt/40">
          <p class="mb-1 text-tiny font-semibold text-txt-muted">Hearing you say...</p>
          <p id="stt-interim-text" class="text-small italic text-txt-muted"></p>
        </div>

        <!-- Transcription Output -->
        <div>
          <div class="mb-2 flex items-center justify-between">
            <label for="stt-output" class="text-small font-semibold text-txt-light dark:text-txt-dark">
              <span class="inline-flex items-center gap-1.5">
                <svg class="h-4 w-4 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
                Transcription
              </span>
            </label>
            <div class="flex items-center gap-2 text-tiny text-txt-muted">
              <span id="stt-word-count" class="badge-neutral">0 words</span>
              <span id="stt-char-count" class="badge-neutral">0 chars</span>
            </div>
          </div>
          <textarea
            id="stt-output"
            class="tool-textarea min-h-[160px] w-full resize-y rounded-xl border border-border-light bg-white/50 px-3 py-3 text-small leading-relaxed backdrop-blur-sm transition-all focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-border-dark dark:bg-white/5"
            placeholder="Your dictated text will appear here..."
            aria-label="Transcribed text output"
            readonly
          ></textarea>
        </div>

        <!-- Empty State -->
        <div id="stt-empty-state" class="flex flex-col items-center justify-center rounded-xl border border-dashed border-border-light bg-surface-light-alt/30 py-6 text-center dark:border-border-dark dark:bg-surface-dark-alt/30">
          <div class="mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow animate-pulse-glow">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/></svg>
          </div>
          <p class="text-small font-semibold text-txt-light dark:text-txt-dark">Ready to dictate</p>
          <p class="mt-1 text-tiny text-txt-muted">Click the microphone button above and start speaking</p>
        </div>

        <!-- Action Buttons -->
        <div id="stt-actions" class="hidden flex-wrap items-center gap-2 sm:gap-3">
          <button id="stt-copy-btn" class="btn-secondary flex-1 px-4 py-3 text-small sm:flex-none" aria-label="Copy transcribed text">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
          <button id="stt-download-btn" class="btn-secondary flex-1 px-4 py-3 text-small sm:flex-none" aria-label="Download as text file">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
            <span>Download</span>
          </button>
          <button id="stt-clear-btn" class="btn-ghost flex-1 px-4 py-3 text-small sm:flex-none" aria-label="Clear transcription">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            <span>Clear</span>
          </button>
        </div>

        <!-- Error State -->
        <div id="stt-error" class="hidden items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-small text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-300">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" x2="12" y1="9" y2="13"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg>
          <span id="stt-error-text">An error occurred.</span>
        </div>

        <!-- Success Toast -->
        <div id="stt-success" class="hidden items-center gap-2 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-small text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-300">
          <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m22 4-10 10.01-3-3"/></svg>
          <span id="stt-success-text">Done!</span>
        </div>
      </div>
    </div>

    <!-- Feature Quick Access Cards -->
    <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3">
      <div class="card-glass group p-3 text-center transition-all hover:scale-[1.02]">
        <div class="mb-1.5 flex justify-center"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-100 text-brand-500 transition-transform group-hover:scale-110 dark:bg-brand-900/30 dark:text-brand-300"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg></div></div>
        <p class="text-tiny font-semibold text-txt-light dark:text-txt-dark">50+ Languages</p>
      </div>
      <div class="card-glass group p-3 text-center transition-all hover:scale-[1.02]">
        <div class="mb-1.5 flex justify-center"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600 transition-transform group-hover:scale-110 dark:bg-cyan-900/30 dark:text-cyan-300"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg></div></div>
        <p class="text-tiny font-semibold text-txt-light dark:text-txt-dark">Live Preview</p>
      </div>
      <div class="card-glass group p-3 text-center transition-all hover:scale-[1.02]">
        <div class="mb-1.5 flex justify-center"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-100 text-accent-500 transition-transform group-hover:scale-110 dark:bg-accent-900/30 dark:text-accent-300"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg></div></div>
        <p class="text-tiny font-semibold text-txt-light dark:text-txt-dark">Timer</p>
      </div>
      <div class="card-glass group p-3 text-center transition-all hover:scale-[1.02]">
        <div class="mb-1.5 flex justify-center"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-100 text-green-600 transition-transform group-hover:scale-110 dark:bg-green-900/30 dark:text-green-300"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg></div></div>
        <p class="text-tiny font-semibold text-txt-light dark:text-txt-dark">Export .txt</p>
      </div>
      <div class="card-glass group p-3 text-center transition-all hover:scale-[1.02]">
        <div class="mb-1.5 flex justify-center"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-100 text-brand-500 transition-transform group-hover:scale-110 dark:bg-brand-900/30 dark:text-brand-300"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg></div></div>
        <p class="text-tiny font-semibold text-txt-light dark:text-txt-dark">Continuous</p>
      </div>
      <div class="card-glass group p-3 text-center transition-all hover:scale-[1.02]">
        <div class="mb-1.5 flex justify-center"><div class="flex h-8 w-8 items-center justify-center rounded-lg bg-accent-100 text-accent-500 transition-transform group-hover:scale-110 dark:bg-accent-900/30 dark:text-accent-300"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></div></div>
        <p class="text-tiny font-semibold text-txt-light dark:text-txt-dark">Private</p>
      </div>
    </div>
  </div>

  <ToolSections slug="speech-to-text" />
</ToolLayout>

<style>
  .stt-mic-btn.recording {
    background: linear-gradient(135deg, #ef4444 0%, #ec4899 100%);
    animation: pulseGlow 1.5s ease-in-out infinite;
  }
  kbd { border: 1px solid var(--color-border); }
  @media (max-width: 358px) {
    .stt-tool .grid-cols-2 { grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  }
</style>

<script is:inline>
  (function () {
    var micBtn = document.getElementById('stt-mic-btn');
    var micLabel = document.getElementById('stt-mic-label');
    var langSelect = document.getElementById('stt-lang');
    var continuousCheck = document.getElementById('stt-continuous');
    var output = document.getElementById('stt-output');
    var interimContainer = document.getElementById('stt-interim-container');
    var interimText = document.getElementById('stt-interim-text');
    var timerBar = document.getElementById('stt-timer-bar');
    var timerEl = document.getElementById('stt-timer');
    var wordCountEl = document.getElementById('stt-word-count');
    var charCountEl = document.getElementById('stt-char-count');
    var emptyState = document.getElementById('stt-empty-state');
    var actionsBar = document.getElementById('stt-actions');
    var copyBtn = document.getElementById('stt-copy-btn');
    var downloadBtn = document.getElementById('stt-download-btn');
    var clearBtn = document.getElementById('stt-clear-btn');
    var errorEl = document.getElementById('stt-error');
    var errorText = document.getElementById('stt-error-text');
    var successEl = document.getElementById('stt-success');
    var successText = document.getElementById('stt-success-text');

    var recognition = null;
    var isRecording = false;
    var timerInterval = null;
    var startTime = 0;
    var finalTranscript = '';
    var autoCapitalize = true;

    function showEl(el) { el.classList.remove('hidden'); el.style.display = 'flex'; }
    function hideEl(el) { el.classList.add('hidden'); el.style.display = 'none'; }
    function showError(msg) { errorText.textContent = msg; showEl(errorEl); setTimeout(function() { hideEl(errorEl); }, 5000); }
    function showSuccess(msg) { successText.textContent = msg; showEl(successEl); setTimeout(function() { hideEl(successEl); }, 2500); }

    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!SpeechRecognition) {
      micBtn.disabled = true;
      micBtn.classList.add('opacity-50', 'cursor-not-allowed');
      micLabel.textContent = 'Not supported in this browser';
      showError('Speech recognition is not supported. Please use Chrome, Edge, or Safari.');
    }

    function initRecognition() {
      recognition = new SpeechRecognition();
      recognition.continuous = continuousCheck.checked;
      recognition.interimResults = true;
      recognition.lang = langSelect.value;

      recognition.onresult = function(event) {
        var interim = '';
        for (var i = event.resultIndex; i < event.results.length; i++) {
          if (event.results[i].isFinal) {
            var transcript = event.results[i][0].transcript;
            if (autoCapitalize && finalTranscript.length > 0 && /[.!?]\s*$/.test(finalTranscript.trim())) {
              transcript = transcript.charAt(0).toUpperCase() + transcript.slice(1);
            }
            if (autoCapitalize && finalTranscript.length === 0) {
              transcript = transcript.charAt(0).toUpperCase() + transcript.slice(1);
            }
            finalTranscript += transcript;
          } else {
            interim += event.results[i][0].transcript;
          }
        }
        output.value = finalTranscript;
        if (interim) {
          interimText.textContent = interim;
          showEl(interimContainer);
        } else {
          hideEl(interimContainer);
        }
        updateCounts();
        hideEl(emptyState);
        showEl(actionsBar);
      };

      recognition.onerror = function(event) {
        if (event.error === 'no-speech') return;
        if (event.error === 'not-allowed' || event.error === 'service-not-allowed') {
          showError('Microphone access denied. Please allow microphone access in your browser settings.');
        } else if (event.error === 'network') {
          showError('Network error. Speech recognition requires an internet connection in some browsers.');
        } else {
          showError('Recognition error: ' + event.error);
        }
        stopRecording();
      };

      recognition.onend = function() {
        if (isRecording && continuousCheck.checked) {
          try { recognition.start(); } catch(e) {}
        } else {
          stopRecording();
        }
      };
    }

    function updateCounts() {
      var text = output.value;
      var wCount = text.trim() ? text.trim().split(/\s+/).length : 0;
      wordCountEl.textContent = wCount + ' words';
      charCountEl.textContent = text.length + ' chars';
    }

    function startTimer() {
      startTime = Date.now();
      timerInterval = setInterval(function() {
        var elapsed = Math.floor((Date.now() - startTime) / 1000);
        var m = Math.floor(elapsed / 60);
        var s = elapsed % 60;
        timerEl.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
      }, 1000);
      showEl(timerBar);
    }

    function stopTimer() {
      if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
      hideEl(timerBar);
    }

    function startRecording() {
      if (!SpeechRecognition) return;
      if (!recognition) initRecognition();
      recognition.lang = langSelect.value;
      recognition.continuous = continuousCheck.checked;
      finalTranscript = output.value;
      try {
        recognition.start();
        isRecording = true;
        micBtn.classList.add('recording');
        micLabel.textContent = 'Listening... Click to stop';
        startTimer();
        hideEl(emptyState);
      } catch(e) {
        showError('Could not start recognition. Please try again.');
      }
    }

    function stopRecording() {
      if (recognition) {
        try { recognition.stop(); } catch(e) {}
      }
      isRecording = false;
      micBtn.classList.remove('recording');
      micLabel.textContent = 'Click to start dictation';
      stopTimer();
      hideEl(interimContainer);
      if (output.value.trim()) { showEl(actionsBar); } else { showEl(emptyState); }
    }

    micBtn.addEventListener('click', function() {
      if (isRecording) { stopRecording(); } else { startRecording(); }
    });

    langSelect.addEventListener('change', function() {
      if (recognition) { recognition.lang = this.value; }
    });

    continuousCheck.addEventListener('change', function() {
      if (recognition) { recognition.continuous = this.checked; }
    });

    copyBtn.addEventListener('click', function() {
      var text = output.value;
      if (!text) return;
      navigator.clipboard.writeText(text).then(function() {
        showSuccess('Copied to clipboard!');
        var orig = copyBtn.innerHTML;
        copyBtn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg><span>Copied!</span>';
        copyBtn.classList.add('text-green-600', 'dark:text-green-400');
        setTimeout(function() { copyBtn.innerHTML = orig; copyBtn.classList.remove('text-green-600', 'dark:text-green-400'); }, 2000);
      });
    });

    downloadBtn.addEventListener('click', function() {
      var text = output.value;
      if (!text) return;
      var blob = new Blob([text], { type: 'text/plain' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'transcription-' + Date.now() + '.txt';
      a.click();
      URL.revokeObjectURL(a.href);
      showSuccess('File downloaded!');
    });

    clearBtn.addEventListener('click', function() {
      output.value = '';
      finalTranscript = '';
      updateCounts();
      showEl(emptyState);
      hideEl(actionsBar);
    });

    output.addEventListener('input', function() {
      finalTranscript = this.value;
      updateCounts();
    });

    document.addEventListener('keydown', function(e) {
      if (e.ctrlKey && e.code === 'Space') {
        e.preventDefault();
        if (isRecording) { stopRecording(); } else { startRecording(); }
      } else if (e.ctrlKey && e.key === 'l') {
        e.preventDefault();
        clearBtn.click();
      } else if (e.ctrlKey && e.key === 'c' && !window.getSelection().toString()) {
        e.preventDefault();
        copyBtn.click();
      }
    });

    updateCounts();
  })();
</script>
