---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="smart-quotes-converter">
  <div class="sqc-tool">
    <!-- Input Section -->
    <div class="card-glass p-5 sm:p-6 mb-4 relative overflow-hidden">
      <div class="pointer-events-none absolute -right-16 -top-16 h-32 w-32 rounded-full bg-purple-500/10 blur-3xl"></div>
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-3">
          <label for="sqc-input" class="text-body font-semibold flex items-center gap-2">
            <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
            Your Text
          </label>
          <div class="flex items-center gap-2">
            <span id="sqc-char-count" class="text-tiny text-txt-muted font-mono">0 chars</span>
            <button id="sqc-clear-btn" class="btn-ghost px-3 py-1.5 text-tiny rounded-lg" title="Clear text">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              Clear
            </button>
          </div>
        </div>
        <textarea id="sqc-input" class="tool-textarea min-h-[140px] w-full" placeholder="Type or paste text with straight quotes here... e.g. He said "hello" and 'goodbye'..." aria-label="Input text for smart quotes conversion" autocomplete="off" spellcheck="false"></textarea>
      </div>
    </div>

    <!-- Conversion Mode Buttons -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          Conversion Mode
        </h3>
        <span class="text-tiny text-txt-muted hidden sm:inline">12 modes</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5" id="sqc-buttons">
        <button class="sqc-btn active" data-mode="curly" title="Straight to curly quotes">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
          <span class="sqc-btn-label">To Curly Quotes</span>
        </button>
        <button class="sqc-btn" data-mode="straight" title="Curly back to straight">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/></svg>
          <span class="sqc-btn-label">To Straight</span>
        </button>
        <button class="sqc-btn" data-mode="apostrophe" title="Smart apostrophes only">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16M8 8l4-4 4 4"/></svg>
          <span class="sqc-btn-label">Smart Apostrophes</span>
        </button>
        <button class="sqc-btn" data-mode="single" title="Smart single quotes">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 4l-6 16"/></svg>
          <span class="sqc-btn-label">Single Quotes</span>
        </button>
        <button class="sqc-btn" data-mode="guillemets" title="French guillemets">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7l-4 5 4 5M16 7l4 5-4 5"/></svg>
          <span class="sqc-btn-label">Guillemets « »</span>
        </button>
        <button class="sqc-btn" data-mode="prime" title="Prime and double prime marks">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4l-2 16M17 4l-2 16"/></svg>
          <span class="sqc-btn-label">Prime Marks ′ ″</span>
        </button>
        <button class="sqc-btn" data-mode="emdashes" title="Convert -- to em dash">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18"/></svg>
          <span class="sqc-btn-label">Em Dashes —</span>
        </button>
        <button class="sqc-btn" data-mode="endashes" title="Convert - to en dash">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          <span class="sqc-btn-label">En Dashes –</span>
        </button>
        <button class="sqc-btn" data-mode="ellipsis" title="Convert ... to ellipsis">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="6" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="18" cy="12" r="1"/></svg>
          <span class="sqc-btn-label">Ellipsis …</span>
        </button>
        <button class="sqc-btn" data-mode="alltypo" title="Full typographic conversion">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4M13 3l3.5 9L20 3M11 17l3 4M11 17l3-4"/></svg>
          <span class="sqc-btn-label">Full Typography</span>
        </button>
        <button class="sqc-btn" data-mode="revert" title="Revert all smart punctuation">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h14l-3-3M3 8l3 3M21 16H7l3 3M21 16l-3-3"/></svg>
          <span class="sqc-btn-label">Revert All</span>
        </button>
        <button class="sqc-btn" data-mode="swap" title="Swap single and double quotes">
          <svg class="sqc-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          <span class="sqc-btn-label">Swap Quotes</span>
        </button>
      </div>
    </div>

    <!-- Options Panel -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <h3 class="text-body font-semibold mb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>
        Options
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="sqc-opt-live" checked class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Live preview</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="sqc-opt-apostrophe" checked class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Convert apostrophes</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="sqc-opt-dashes" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Convert dashes</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="sqc-opt-ellipsis" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Convert ellipsis</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="sqc-opt-multiple" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Preserve multiple quotes</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="sqc-opt-html" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Output HTML entities</span>
        </label>
      </div>
    </div>

    <!-- Result Section -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Result
        </h3>
        <div class="flex items-center gap-2">
          <span id="sqc-status" class="text-tiny text-txt-muted"></span>
          <button id="sqc-copy-btn" class="btn-primary px-4 py-2 text-small rounded-xl" disabled title="Copy result (Ctrl+Shift+C)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>
      <div id="sqc-empty" class="flex flex-col items-center justify-center py-12 text-center">
        <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-light-alt text-brand-400 dark:bg-surface-dark-alt dark:text-brand-500">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
        </div>
        <p class="text-small text-txt-muted">Enter text above and select a conversion mode to see the result</p>
      </div>
      <div id="sqc-result-wrap" class="hidden">
        <div id="sqc-result" class="tool-textarea min-h-[140px] w-full bg-surface-light-alt/50 dark:bg-surface-dark-alt/50 font-mono text-small leading-relaxed whitespace-pre-wrap break-words cursor-text" role="textbox" aria-label="Converted text result" tabindex="0"></div>
        <div class="mt-3 flex items-center justify-between text-tiny text-txt-muted">
          <span id="sqc-result-count"></span>
          <span id="sqc-active-mode" class="badge-brand"></span>
        </div>
      </div>
    </div>

    <!-- Diff Stats -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <h3 class="text-body font-semibold mb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 16v-5M12 16V7M17 16v-3"/></svg>
        Conversion Stats
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Double Quotes</div>
          <div id="sqc-stat-double" class="text-body font-bold text-txt-light dark:text-txt-dark">0</div>
        </div>
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Single Quotes</div>
          <div id="sqc-stat-single" class="text-body font-bold text-txt-light dark:text-txt-dark">0</div>
        </div>
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Apostrophes</div>
          <div id="sqc-stat-apostrophe" class="text-body font-bold text-txt-light dark:text-txt-dark">0</div>
        </div>
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Total Changes</div>
          <div id="sqc-stat-changes" class="text-body font-bold text-brand-600 dark:text-brand-300">0</div>
        </div>
      </div>
    </div>

    <!-- Keyboard shortcuts help -->
    <div class="card-glass p-4 mb-4">
      <details>
        <summary class="cursor-pointer text-small font-semibold text-txt-muted flex items-center gap-2 list-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"/></svg>
          Keyboard Shortcuts
          <svg class="h-4 w-4 transition-transform ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-tiny text-txt-muted">
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Copy result</span><kbd class="kbd">Ctrl+Shift+C</kbd></div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Clear text</span><kbd class="kbd">Ctrl+Shift+K</kbd></div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Focus input</span><kbd class="kbd">Ctrl+I</kbd></div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Toggle live preview</span><kbd class="kbd">Ctrl+L</kbd></div>
        </div>
      </details>
    </div>
  </div>

  <ToolSections slug="smart-quotes-converter" />
</ToolLayout>

<style>
  .sqc-btn {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 12px 8px; border-radius: 12px; border: 1px solid var(--color-border);
    background: var(--color-surface); cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); min-height: 64px;
    position: relative; overflow: hidden;
  }
  .sqc-btn::before {
    content: ''; position: absolute; inset: 0;
    background: var(--color-brand-gradient); opacity: 0;
    transition: opacity 0.25s ease; z-index: 0;
  }
  .sqc-btn > * { position: relative; z-index: 1; }
  .sqc-btn:hover {
    border-color: var(--color-brand); transform: translateY(-2px);
    box-shadow: 0 4px 16px -4px rgba(124, 58, 237, 0.2);
  }
  .sqc-btn:active { transform: translateY(0) scale(0.98); }
  .sqc-btn.active::before { opacity: 1; }
  .sqc-btn.active { color: #fff; border-color: transparent; }
  .sqc-btn.active .sqc-btn-icon, .sqc-btn.active .sqc-btn-label { color: #fff; stroke: #fff; }
  .sqc-btn-icon { width: 20px; height: 20px; color: var(--color-brand); }
  .sqc-btn-label { font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted); text-align: center; line-height: 1.2; }
  .sqc-btn:hover .sqc-btn-label { color: var(--color-text); }
  .dark .sqc-btn { background: var(--color-surface); }
  .dark .sqc-btn-icon { color: var(--color-brand); }
  .kbd {
    display: inline-flex; align-items: center; padding: 2px 8px;
    border-radius: 6px; border: 1px solid var(--color-border);
    background: var(--color-surface-alt); font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem; font-weight: 600; color: var(--color-text);
  }
  details summary::-webkit-details-marker { display: none; }
  details summary::marker { content: ''; }
  @media (max-width: 358px) {
    .sqc-btn { padding: 10px 6px; min-height: 56px; }
    .sqc-btn-icon { width: 18px; height: 18px; }
    .sqc-btn-label { font-size: 0.6875rem; }
  }
</style>

<script is:inline>
(function () {
  var input = document.getElementById('sqc-input');
  var charCount = document.getElementById('sqc-char-count');
  var clearBtn = document.getElementById('sqc-clear-btn');
  var copyBtn = document.getElementById('sqc-copy-btn');
  var emptyState = document.getElementById('sqc-empty');
  var resultWrap = document.getElementById('sqc-result-wrap');
  var resultEl = document.getElementById('sqc-result');
  var resultCount = document.getElementById('sqc-result-count');
  var activeModeEl = document.getElementById('sqc-active-mode');
  var statusEl = document.getElementById('sqc-status');
  var buttons = document.querySelectorAll('.sqc-btn');
  var optLive = document.getElementById('sqc-opt-live');
  var optApostrophe = document.getElementById('sqc-opt-apostrophe');
  var optDashes = document.getElementById('sqc-opt-dashes');
  var optEllipsis = document.getElementById('sqc-opt-ellipsis');
  var optMultiple = document.getElementById('sqc-opt-multiple');
  var optHtml = document.getElementById('sqc-opt-html');
  var statDouble = document.getElementById('sqc-stat-double');
  var statSingle = document.getElementById('sqc-stat-single');
  var statApostrophe = document.getElementById('sqc-stat-apostrophe');
  var statChanges = document.getElementById('sqc-stat-changes');
  var currentResult = '';
  var activeBtn = document.querySelector('.sqc-btn.active');
  var activeMode = 'curly';

  var modeLabels = {
    curly: 'To Curly', straight: 'To Straight', apostrophe: 'Smart Apostrophes',
    single: 'Single Quotes', guillemets: 'Guillemets', prime: 'Prime Marks',
    emdashes: 'Em Dashes', endashes: 'En Dashes', ellipsis: 'Ellipsis',
    alltypo: 'Full Typography', revert: 'Revert All', swap: 'Swap Quotes'
  };

  var htmlEntities = {
    '\u201C': '&ldquo;', '\u201D': '&rdquo;', '\u2018': '&lsquo;', '\u2019': '&rsquo;',
    '\u00AB': '&laquo;', '\u00BB': '&raquo;', '\u2032': '&prime;', '\u2033': '&Prime;',
    '\u2014': '&mdash;', '\u2013': '&ndash;', '\u2026': '&hellip;'
  };

  function toHtmlEntities(text) {
    return text.replace(/[\u201C\u201D\u2018\u2019\u00AB\u00BB\u2032\u2033\u2014\u2013\u2026]/g, function (c) {
      return htmlEntities[c] || c;
    });
  }

  function convertToCurly(text) {
    var result = '';
    var openDouble = true;
    var openSingle = true;
    var changes = { double: 0, single: 0, apostrophe: 0 };

    for (var i = 0; i < text.length; i++) {
      var ch = text[i];
      var prev = i > 0 ? text[i - 1] : ' ';
      var next = i < text.length - 1 ? text[i + 1] : ' ';

      if (ch === '"') {
        if (optMultiple.checked && i + 1 < text.length && text[i + 1] === '"') {
          result += openDouble ? '\u201C\u201C' : '\u201D\u201D';
          openDouble = !openDouble;
          changes.double += 2;
          i++;
        } else {
          if (openDouble) { result += '\u201C'; changes.double++; }
          else { result += '\u201D'; changes.double++; }
          openDouble = !openDouble;
        }
      } else if (ch === "'") {
        if (optApostrophe.checked && /[a-zA-Z]/.test(prev) && !/[a-zA-Z]/.test(next) || (prev === ' ' && /[a-zA-Z]/.test(next) && i + 1 < text.length && text[i + 2] && /[a-zA-Z]/.test(text[i + 2]))) {
          if (prev === ' ' && /[a-zA-Z]/.test(next)) {
            if (openSingle) { result += '\u2018'; changes.single++; }
            else { result += '\u2019'; changes.single++; }
            openSingle = !openSingle;
          } else {
            result += '\u2019';
            changes.apostrophe++;
          }
        } else if (ch === "'" && prev === ' ' && next !== ' ') {
          if (openSingle) { result += '\u2018'; changes.single++; }
          else { result += '\u2019'; changes.single++; }
          openSingle = !openSingle;
        } else {
          if (optApostrophe.checked) {
            result += '\u2019';
            changes.apostrophe++;
          } else {
            result += ch;
          }
        }
      } else if (ch === '\n') {
        result += ch;
        openDouble = true;
        openSingle = true;
      } else {
        result += ch;
      }
    }

    if (optDashes.checked) {
      result = result.replace(/--/g, '\u2014');
      result = result.replace(/(\s)-(\s)/g, '$1\u2013$2');
    }
    if (optEllipsis.checked) {
      result = result.replace(/\.\.\./g, '\u2026');
    }

    return { text: result, stats: changes };
  }

  function convertToStraight(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text
      .replace(/[\u201C\u201D\u201E\u201F\u275D\u275E\u301D\u301E\uFF02]/g, function () { changes.double++; return '"'; })
      .replace(/[\u2018\u201A\u201B\u275B\u275C\u301F\uFF07]/g, function () { changes.single++; return "'"; })
      .replace(/\u2019/g, function () { changes.apostrophe++; return "'"; });
    if (optDashes.checked) {
      result = result.replace(/\u2014/g, function () { return '--'; });
      result = result.replace(/\u2013/g, function () { return '-'; });
    }
    if (optEllipsis.checked) {
      result = result.replace(/\u2026/g, function () { return '...'; });
    }
    return { text: result, stats: changes };
  }

  function convertApostrophes(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text.replace(/(\w)'(\w)/g, function (m, pre, post) {
      changes.apostrophe++;
      return pre + '\u2019' + post;
    });
    result = result.replace(/(\w)'(\s|$)/g, function (m, pre, post) {
      changes.apostrophe++;
      return pre + '\u2019' + post;
    });
    result = result.replace(/(\s|^)'(\w)/g, function (m, pre, post) {
      changes.apostrophe++;
      return pre + '\u2019' + post;
    });
    return { text: result, stats: changes };
  }

  function convertSingleQuotes(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = '';
    var openSingle = true;
    for (var i = 0; i < text.length; i++) {
      var ch = text[i];
      var prev = i > 0 ? text[i - 1] : ' ';
      if (ch === "'") {
        if (/[a-zA-Z]/.test(prev)) {
          result += '\u2019';
          changes.apostrophe++;
        } else {
          if (openSingle) { result += '\u2018'; changes.single++; }
          else { result += '\u2019'; changes.single++; }
          openSingle = !openSingle;
        }
      } else if (ch === '\n') {
        result += ch;
        openSingle = true;
      } else {
        result += ch;
      }
    }
    return { text: result, stats: changes };
  }

  function convertGuillemets(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = '';
    var openDouble = true;
    var openSingle = true;
    for (var i = 0; i < text.length; i++) {
      var ch = text[i];
      if (ch === '"') {
        if (openDouble) { result += '\u00AB'; changes.double++; }
        else { result += '\u00BB'; changes.double++; }
        openDouble = !openDouble;
      } else if (ch === "'" && !/[a-zA-Z]/.test(i > 0 ? text[i - 1] : ' ')) {
        if (openSingle) { result += '\u2039'; changes.single++; }
        else { result += '\u203A'; changes.single++; }
        openSingle = !openSingle;
      } else if (ch === "'" && optApostrophe.checked) {
        result += '\u2019';
        changes.apostrophe++;
      } else if (ch === '\n') {
        result += ch;
        openDouble = true;
        openSingle = true;
      } else {
        result += ch;
      }
    }
    return { text: result, stats: changes };
  }

  function convertPrimes(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text
      .replace(/(\d|\b)''/g, function (m, pre) { changes.double++; return pre + '\u2033'; })
      .replace(/(\d|\b)'/g, function (m, pre) { changes.single++; return pre + '\u2032'; })
      .replace(/"/g, function () { changes.double++; return '\u2033'; });
    return { text: result, stats: changes };
  }

  function convertEmDashes(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text.replace(/(\s)--(\s)/g, function (m, pre, post) {
      changes.apostrophe++;
      return pre + '\u2014' + post;
    }).replace(/^--(\s)/gm, function (m, post) {
      changes.apostrophe++;
      return '\u2014' + post;
    });
    return { text: result, stats: changes };
  }

  function convertEnDashes(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text.replace(/(\s)-(\s)/g, function (m, pre, post) {
      changes.apostrophe++;
      return pre + '\u2013' + post;
    }).replace(/(\d)-(\d)/g, function (m, pre, post) {
      changes.apostrophe++;
      return pre + '\u2013' + post;
    });
    return { text: result, stats: changes };
  }

  function convertEllipsis(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text.replace(/\.\.\./g, function () {
      changes.apostrophe++;
      return '\u2026';
    });
    return { text: result, stats: changes };
  }

  function convertAllTypo(text) {
    var r1 = convertToCurly(text);
    var r2 = convertEmDashes(r1.text);
    var r3 = convertEllipsis(r2.text);
    var stats = r1.stats;
    stats.apostrophe += r2.stats.apostrophe + r3.stats.apostrophe;
    return { text: r3.text, stats: stats };
  }

  function revertAll(text) {
    return convertToStraight(text);
  }

  function swapQuotes(text) {
    var changes = { double: 0, single: 0, apostrophe: 0 };
    var result = text
      .replace(/"/g, function () { changes.double++; return "'"; })
      .replace(/'/g, function () { changes.single++; return '"'; })
      .replace(/\u201C/g, function () { changes.double++; return '\u2018'; })
      .replace(/\u201D/g, function () { changes.double++; return '\u2019'; })
      .replace(/\u2018/g, function () { changes.single++; return '\u201C'; })
      .replace(/\u2019/g, function () { changes.single++; return '\u201D'; });
    return { text: result, stats: changes };
  }

  function process(text, mode) {
    var result;
    switch (mode) {
      case 'curly': result = convertToCurly(text); break;
      case 'straight': result = convertToStraight(text); break;
      case 'apostrophe': result = convertApostrophes(text); break;
      case 'single': result = convertSingleQuotes(text); break;
      case 'guillemets': result = convertGuillemets(text); break;
      case 'prime': result = convertPrimes(text); break;
      case 'emdashes': result = convertEmDashes(text); break;
      case 'endashes': result = convertEnDashes(text); break;
      case 'ellipsis': result = convertEllipsis(text); break;
      case 'alltypo': result = convertAllTypo(text); break;
      case 'revert': result = revertAll(text); break;
      case 'swap': result = swapQuotes(text); break;
      default: result = { text: text, stats: { double: 0, single: 0, apostrophe: 0 } };
    }
    if (optHtml.checked) {
      result.text = toHtmlEntities(result.text);
    }
    return result;
  }

  function updateCharCount() {
    charCount.textContent = input.value.length + ' chars';
  }

  function showResult(text, mode, stats) {
    currentResult = text;
    resultEl.textContent = text;
    emptyState.classList.add('hidden');
    resultWrap.classList.remove('hidden');
    resultWrap.classList.add('animate-slide-up');
    resultCount.textContent = text.length + ' characters';
    activeModeEl.textContent = modeLabels[mode] || '';
    copyBtn.disabled = false;
    statusEl.textContent = '✓ Converted';
    statusEl.classList.add('text-green-600', 'dark:text-green-400');
    statDouble.textContent = stats.double;
    statSingle.textContent = stats.single;
    statApostrophe.textContent = stats.apostrophe;
    statChanges.textContent = stats.double + stats.single + stats.apostrophe;
    setTimeout(function () { resultWrap.classList.remove('animate-slide-up'); }, 500);
  }

  function clearResult() {
    currentResult = '';
    resultEl.textContent = '';
    emptyState.classList.remove('hidden');
    resultWrap.classList.add('hidden');
    copyBtn.disabled = true;
    statusEl.textContent = '';
    activeModeEl.textContent = '';
    statDouble.textContent = '0';
    statSingle.textContent = '0';
    statApostrophe.textContent = '0';
    statChanges.textContent = '0';
  }

  function runMode(mode, btn) {
    var text = input.value;
    if (!text.trim()) {
      input.focus();
      input.classList.add('ring-2', 'ring-brand-500/30');
      setTimeout(function () { input.classList.remove('ring-2', 'ring-brand-500/30'); }, 600);
      return;
    }
    if (activeBtn) activeBtn.classList.remove('active');
    btn.classList.add('active');
    activeBtn = btn;
    activeMode = mode;
    var result = process(text, mode);
    showResult(result.text, mode, result.stats);
  }

  function liveUpdate() {
    if (!optLive.checked || !input.value.trim()) { clearResult(); return; }
    if (!activeMode) return;
    var result = process(input.value, activeMode);
    showResult(result.text, activeMode, result.stats);
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      runMode(btn.getAttribute('data-mode'), btn);
    });
  });

  clearBtn.addEventListener('click', function () {
    input.value = '';
    updateCharCount();
    clearResult();
    input.focus();
  });

  copyBtn.addEventListener('click', function () {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult).then(function () {
      var orig = copyBtn.innerHTML;
      copyBtn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>Copied!</span>';
      copyBtn.classList.add('!bg-green-500');
      setTimeout(function () {
        copyBtn.innerHTML = orig;
        copyBtn.classList.remove('!bg-green-500');
      }, 2000);
    });
  });

  [optLive, optApostrophe, optDashes, optEllipsis, optMultiple, optHtml].forEach(function (opt) {
    opt.addEventListener('change', function () {
      if (optLive.checked && input.value.trim() && activeMode) {
        var result = process(input.value, activeMode);
        showResult(result.text, activeMode, result.stats);
      }
    });
  });

  input.addEventListener('input', function () {
    updateCharCount();
    if (optLive.checked && activeMode && input.value.trim()) {
      var result = process(input.value, activeMode);
      showResult(result.text, activeMode, result.stats);
    } else if (!input.value.trim()) {
      clearResult();
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'C') {
      e.preventDefault();
      if (!copyBtn.disabled) copyBtn.click();
    } else if (e.ctrlKey && e.shiftKey && e.key === 'K') {
      e.preventDefault();
      clearBtn.click();
    } else if (e.ctrlKey && e.key === 'i') {
      e.preventDefault();
      input.focus();
    } else if (e.ctrlKey && e.key === 'l') {
      e.preventDefault();
      optLive.checked = !optLive.checked;
      optLive.dispatchEvent(new Event('change'));
    }
  });

  updateCharCount();
})();
</script>
