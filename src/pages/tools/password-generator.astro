---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="password-generator">
  <div class="space-y-4">
    <div class="card-glass p-4 sm:p-6">
      <h2 class="mb-4 text-h4 font-bold">Password Generator</h2>

      <div class="space-y-4">
        <div class="rounded-xl border border-border-light bg-surface-light-alt/50 p-4 dark:border-border-dark dark:bg-surface-dark-alt/50">
          <div class="mb-2 flex items-center justify-between gap-2">
            <span class="text-small font-semibold text-txt-muted">Generated Password</span>
            <div class="flex items-center gap-2">
              <button id="pw-toggle" class="btn-ghost px-2 py-1 text-tiny" title="Show/Hide" aria-label="Toggle password visibility">
                <svg id="pw-eye" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
              <button id="pw-regenerate" class="btn-ghost px-2 py-1 text-tiny" title="Regenerate" aria-label="Regenerate password">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
              </button>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <input id="pw-output" type="password" class="tool-input min-h-[56px] flex-1 font-mono text-h4 tracking-wider" readonly aria-label="Generated password" />
            <button id="pw-copy" class="btn-primary px-4 py-3 text-small" data-copy-target="pw-output">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              Copy
            </button>
          </div>
          <div class="mt-3">
            <div class="flex items-center justify-between text-tiny text-txt-muted">
              <span>Strength</span>
              <span id="pw-strength-label">—</span>
            </div>
            <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-surface-light dark:bg-surface-dark">
              <div id="pw-strength-bar" class="h-full rounded-full transition-all duration-300" style="width:0%"></div>
            </div>
          </div>
        </div>

        <div>
          <div class="mb-2 flex items-center justify-between">
            <label for="pw-length" class="text-small font-semibold text-txt-muted">Length</label>
            <span id="pw-length-val" class="badge-brand">16</span>
          </div>
          <input id="pw-length" type="range" min="4" max="128" value="16" class="w-full accent-brand-500" aria-label="Password length" />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2.5 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="pw-upper" class="accent-brand-500" checked />
            <span>Uppercase (A-Z)</span>
          </label>
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2.5 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="pw-lower" class="accent-brand-500" checked />
            <span>Lowercase (a-z)</span>
          </label>
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2.5 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="pw-numbers" class="accent-brand-500" checked />
            <span>Numbers (0-9)</span>
          </label>
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2.5 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="pw-symbols" class="accent-brand-500" checked />
            <span>Symbols (!@#$)</span>
          </label>
        </div>

        <div class="flex flex-wrap gap-2">
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="pw-exclude-similar" class="accent-brand-500" />
            <span>Exclude similar (l,1,I,O,0)</span>
          </label>
          <div class="flex rounded-xl border border-border-light bg-surface-light p-1 dark:border-border-dark dark:bg-surface-dark">
            <button id="pw-mode-random" class="rounded-lg px-3 py-1.5 text-small font-semibold bg-brand-500 text-white transition-all">Random</button>
            <button id="pw-mode-pronounce" class="rounded-lg px-3 py-1.5 text-small font-semibold text-txt-muted transition-all">Pronounceable</button>
            <button id="pw-mode-passphrase" class="rounded-lg px-3 py-1.5 text-small font-semibold text-txt-muted transition-all">Passphrase</button>
          </div>
        </div>

        <div id="pw-batch-wrap" class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="pw-batch" class="text-small font-semibold text-txt-muted">Batch Count</label>
            <input id="pw-batch" type="number" class="tool-input min-h-[40px] w-20 px-3 py-1 text-small" value="1" min="1" max="100" aria-label="Batch count" />
          </div>
          <div id="pw-batch-list" class="hidden space-y-2"></div>
        </div>

        <div>
          <h4 class="mb-2 text-small font-semibold text-txt-muted">History (last 10)</h4>
          <div id="pw-history" class="space-y-1">
            <p class="text-tiny text-txt-muted italic">No passwords generated yet.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ToolSections slug="password-generator" />
</ToolLayout>

<script>
(function() {
  const output = document.getElementById('pw-output') as HTMLInputElement;
  const lengthSlider = document.getElementById('pw-length') as HTMLInputElement;
  const lengthVal = document.getElementById('pw-length-val') as HTMLElement;
  const upper = document.getElementById('pw-upper') as HTMLInputElement;
  const lower = document.getElementById('pw-lower') as HTMLInputElement;
  const numbers = document.getElementById('pw-numbers') as HTMLInputElement;
  const symbols = document.getElementById('pw-symbols') as HTMLInputElement;
  const excludeSimilar = document.getElementById('pw-exclude-similar') as HTMLInputElement;
  const toggleBtn = document.getElementById('pw-toggle') as HTMLButtonElement;
  const regenerateBtn = document.getElementById('pw-regenerate') as HTMLButtonElement;
  const copyBtn = document.getElementById('pw-copy') as HTMLButtonElement;
  const strengthBar = document.getElementById('pw-strength-bar') as HTMLElement;
  const strengthLabel = document.getElementById('pw-strength-label') as HTMLElement;
  const batchInput = document.getElementById('pw-batch') as HTMLInputElement;
  const batchList = document.getElementById('pw-batch-list') as HTMLElement;
  const historyEl = document.getElementById('pw-history') as HTMLElement;
  const modeRandom = document.getElementById('pw-mode-random') as HTMLButtonElement;
  const modePronounce = document.getElementById('pw-mode-pronounce') as HTMLButtonElement;
  const modePassphrase = document.getElementById('pw-mode-passphrase') as HTMLButtonElement;

  let mode = 'random';
  let history: string[] = [];

  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const NUMS = '0123456789';
  const SYMS = '!@#$%^&*()_+-=[]{}|;:,.<>?';
  const SIMILAR = 'l1IO0';
  const CONSONANTS = 'bcdfghjklmnpqrstvwxz';
  const VOWELS = 'aeiouy';
  const PASSPHRASE_WORDS = 'correct horse battery staple happy apple ocean mountain river forest cloud dream light star moon sun wave storm flame peace truth brave noble swift calm bold wise kind fair strong free wild grace hope joy love trust faith dawn dusk pride glory honor power beauty wonder magic mystery adventure journey discovery freedom destiny harmony infinity'.split(' ');

  function secureRandom(max: number): number {
    const arr = new Uint32Array(1);
    crypto.getRandomValues(arr);
    return arr[0] % max;
  }

  function getCharset(): string {
    let charset = '';
    if (upper.checked) charset += UPPER;
    if (lower.checked) charset += LOWER;
    if (numbers.checked) charset += NUMS;
    if (symbols.checked) charset += SYMS;
    if (excludeSimilar.checked) {
      charset = charset.split('').filter(c => !SIMILAR.includes(c)).join('');
    }
    return charset;
  }

  function generateRandom(): string {
    const charset = getCharset();
    if (!charset) return '';
    const len = parseInt(lengthSlider.value);
    let result = '';
    for (let i = 0; i < len; i++) {
      result += charset[secureRandom(charset.length)];
    }
    return result;
  }

  function generatePronounceable(): string {
    const len = parseInt(lengthSlider.value);
    let result = '';
    let useConsonant = true;
    while (result.length < len) {
      if (useConsonant) {
        result += CONSONANTS[secureRandom(CONSONANTS.length)];
        if (Math.random() > 0.7) result += CONSONANTS[secureRandom(CONSONANTS.length)];
      } else {
        result += VOWELS[secureRandom(VOWELS.length)];
      }
      useConsonant = !useConsonant;
    }
    return result.slice(0, len);
  }

  function generatePassphrase(): string {
    const len = Math.max(3, Math.ceil(parseInt(lengthSlider.value) / 5));
    let words: string[] = [];
    for (let i = 0; i < len; i++) {
      words.push(PASSPHRASE_WORDS[secureRandom(PASSPHRASE_WORDS.length)]);
    }
    return words.join('-');
  }

  function generate(): string {
    if (mode === 'pronounce') return generatePronounceable();
    if (mode === 'passphrase') return generatePassphrase();
    return generateRandom();
  }

  function calcStrength(pwd: string): { score: number; label: string; color: string } {
    if (!pwd) return { score: 0, label: '—', color: '#94a3b8' };
    let score = 0;
    if (pwd.length >= 8) score += 1;
    if (pwd.length >= 12) score += 1;
    if (pwd.length >= 16) score += 1;
    if (pwd.length >= 24) score += 1;
    if (/[a-z]/.test(pwd)) score += 1;
    if (/[A-Z]/.test(pwd)) score += 1;
    if (/[0-9]/.test(pwd)) score += 1;
    if (/[^a-zA-Z0-9]/.test(pwd)) score += 1;
    const labels = [
      { label: 'Very Weak', color: '#ef4444' },
      { label: 'Weak', color: '#f97316' },
      { label: 'Fair', color: '#eab308' },
      { label: 'Good', color: '#22c55e' },
      { label: 'Strong', color: '#10b981' },
      { label: 'Very Strong', color: '#059669' },
      { label: 'Excellent', color: '#0d9488' },
      { label: 'Excellent', color: '#0d9488' },
      { label: 'Excellent', color: '#0d9488' },
    ];
    const idx = Math.min(score, labels.length - 1);
    const pct = Math.min((score / 8) * 100, 100);
    return { score: pct, label: labels[idx].label, color: labels[idx].color };
  }

  function updateStrength(pwd: string) {
    const s = calcStrength(pwd);
    strengthBar.style.width = s.score + '%';
    strengthBar.style.background = s.color;
    strengthLabel.textContent = s.label;
    strengthLabel.style.color = s.color;
  }

  function addToHistory(pwd: string) {
    history.unshift(pwd);
    if (history.length > 10) history = history.slice(0, 10);
    renderHistory();
  }

  function renderHistory() {
    if (history.length === 0) {
      historyEl.innerHTML = '<p class="text-tiny text-txt-muted italic">No passwords generated yet.</p>';
      return;
    }
    historyEl.innerHTML = history.map((p, i) =>
      '<div class="flex items-center justify-between rounded-lg border border-border-light bg-surface-light px-3 py-1.5 dark:border-border-dark dark:bg-surface-dark">' +
      '<span class="font-mono text-tiny truncate flex-1">' + escapeHtml(p) + '</span>' +
      '<button class="ml-2 rounded p-1 text-txt-muted hover:text-brand-500" data-pw-hist="' + i + '" aria-label="Copy password">' +
      '<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>'
    ).join('');
    historyEl.querySelectorAll('[data-pw-hist]').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-pw-hist')!);
        navigator.clipboard.writeText(history[idx]);
      });
    });
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  function doGenerate() {
    const pwd = generate();
    output.value = pwd;
    output.type = 'password';
    updateStrength(pwd);
    addToHistory(pwd);
    const batch = parseInt(batchInput.value) || 1;
    if (batch > 1) {
      let items: string[] = [];
      for (let i = 0; i < batch; i++) items.push(generate());
      batchList.classList.remove('hidden');
      batchList.innerHTML = items.map((p, i) =>
        '<div class="flex items-center justify-between rounded-lg border border-border-light bg-surface-light px-3 py-2 dark:border-border-dark dark:bg-surface-dark">' +
        '<span class="font-mono text-tiny truncate flex-1">' + escapeHtml(p) + '</span>' +
        '<button class="ml-2 rounded p-1 text-txt-muted hover:text-brand-500" data-pw-batch="' + i + '">' +
        '<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>'
      ).join('');
      batchList.querySelectorAll('[data-pw-batch]').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-pw-batch')!);
          navigator.clipboard.writeText(items[idx]);
        });
      });
    } else {
      batchList.classList.add('hidden');
    }
  }

  function setMode(m: string) {
    mode = m;
    [modeRandom, modePronounce, modePassphrase].forEach(btn => {
      btn.classList.remove('bg-brand-500', 'text-white');
      btn.classList.add('text-txt-muted');
    });
    const active = m === 'pronounce' ? modePronounce : m === 'passphrase' ? modePassphrase : modeRandom;
    active.classList.add('bg-brand-500', 'text-white');
    active.classList.remove('text-txt-muted');
    doGenerate();
  }

  lengthSlider.addEventListener('input', () => {
    lengthVal.textContent = lengthSlider.value;
    doGenerate();
  });
  [upper, lower, numbers, symbols, excludeSimilar].forEach(el => el.addEventListener('change', doGenerate));
  batchInput.addEventListener('input', doGenerate);
  regenerateBtn.addEventListener('click', doGenerate);
  toggleBtn.addEventListener('click', () => {
    output.type = output.type === 'password' ? 'text' : 'password';
  });
  modeRandom.addEventListener('click', () => setMode('random'));
  modePronounce.addEventListener('click', () => setMode('pronounce'));
  modePassphrase.addEventListener('click', () => setMode('passphrase'));

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); doGenerate(); }
    if ((e.ctrlKey || e.metaKey) && (e.key === 'r' || e.key === 'R')) { e.preventDefault(); doGenerate(); }
    if (e.key === ' ' && document.activeElement === document.body) { e.preventDefault(); toggleBtn.click(); }
  });

  doGenerate();
})();
</script>
