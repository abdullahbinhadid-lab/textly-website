---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="random-word-generator">
  <div class="space-y-4">
    <div class="card-glass p-4 sm:p-6">
      <h2 class="mb-4 text-h4 font-bold">Random Word Generator</h2>

      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rw-category" class="mb-1.5 block text-small font-semibold text-txt-muted">Category</label>
            <select id="rw-category" class="tool-input min-h-[48px] w-full" aria-label="Word category">
              <option value="nouns">Nouns</option>
              <option value="verbs">Verbs</option>
              <option value="adjectives">Adjectives</option>
              <option value="adverbs">Adverbs</option>
              <option value="all">All Words</option>
              <option value="mixed">Mixed</option>
            </select>
          </div>
          <div>
            <label for="rw-count" class="mb-1.5 block text-small font-semibold text-txt-muted">Count</label>
            <input id="rw-count" type="number" class="tool-input min-h-[48px] w-full" value="10" min="1" max="500" aria-label="Word count" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rw-min-len" class="mb-1.5 block text-small font-semibold text-txt-muted">Min Length</label>
            <input id="rw-min-len" type="number" class="tool-input min-h-[48px] w-full" value="0" min="0" max="20" aria-label="Minimum word length" />
          </div>
          <div>
            <label for="rw-max-len" class="mb-1.5 block text-small font-semibold text-txt-muted">Max Length</label>
            <input id="rw-max-len" type="number" class="tool-input min-h-[48px] w-full" value="0" min="0" max="30" aria-label="Maximum word length" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rw-starts" class="mb-1.5 block text-small font-semibold text-txt-muted">Starts with</label>
            <input id="rw-starts" type="text" class="tool-input min-h-[48px] w-full" placeholder="e.g. ab" aria-label="Starts with" />
          </div>
          <div>
            <label for="rw-ends" class="mb-1.5 block text-small font-semibold text-txt-muted">Ends with</label>
            <input id="rw-ends" type="text" class="tool-input min-h-[48px] w-full" placeholder="e.g. ing" aria-label="Ends with" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rw-include" class="mb-1.5 block text-small font-semibold text-txt-muted">Include pattern</label>
            <input id="rw-include" type="text" class="tool-input min-h-[48px] w-full" placeholder="e.g. th" aria-label="Include pattern" />
          </div>
          <div>
            <label for="rw-exclude" class="mb-1.5 block text-small font-semibold text-txt-muted">Exclude pattern</label>
            <input id="rw-exclude" type="text" class="tool-input min-h-[48px] w-full" placeholder="e.g. xyz" aria-label="Exclude pattern" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="rw-syllables" class="mb-1.5 block text-small font-semibold text-txt-muted">Syllables</label>
            <select id="rw-syllables" class="tool-input min-h-[48px] w-full" aria-label="Syllable count filter">
              <option value="0">Any</option>
              <option value="1">1 syllable</option>
              <option value="2">2 syllables</option>
              <option value="3">3 syllables</option>
              <option value="4">4 syllables</option>
              <option value="5">5 syllables</option>
            </select>
          </div>
          <div>
            <label for="rw-format" class="mb-1.5 block text-small font-semibold text-txt-muted">Output Format</label>
            <select id="rw-format" class="tool-input min-h-[48px] w-full" aria-label="Output format">
              <option value="space">Space separated</option>
              <option value="newline">New line</option>
              <option value="csv">CSV</option>
              <option value="json">JSON array</option>
              <option value="numbered">Numbered list</option>
            </select>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="rw-unique" class="accent-brand-500" checked />
            <span>Unique only</span>
          </label>
        </div>

        <div class="flex flex-wrap gap-2">
          <button id="rw-generate" class="btn-primary px-5 py-2.5 text-small">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Generate
            <kbd class="ml-1 hidden rounded bg-white/20 px-1.5 py-0.5 text-tiny sm:inline">Ctrl+Enter</kbd>
          </button>
          <button id="rw-clear" class="btn-ghost px-5 py-2.5 text-small">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Clear
          </button>
        </div>
      </div>
    </div>

    <div class="card-glass p-4 sm:p-6">
      <div class="mb-3 flex items-center justify-between gap-2">
        <h3 class="text-body font-semibold">Generated Words</h3>
        <div class="flex items-center gap-2">
          <span id="rw-stats" class="text-small text-txt-muted"></span>
          <button id="rw-copy" class="btn-secondary px-4 py-2 text-small" data-copy-target="rw-output">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy
          </button>
          <button id="rw-download" class="btn-ghost px-4 py-2 text-small">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 10l5 5 5-5"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 15V3"/></svg>
            Download
          </button>
        </div>
      </div>
      <textarea id="rw-output" class="tool-textarea min-h-[180px] w-full" readonly placeholder="Random words will appear here..." aria-label="Generated words"></textarea>
    </div>
  </div>

  <ToolSections slug="random-word-generator" />
</ToolLayout>

<script>
(function() {
  const category = document.getElementById('rw-category') as HTMLSelectElement;
  const count = document.getElementById('rw-count') as HTMLInputElement;
  const minLen = document.getElementById('rw-min-len') as HTMLInputElement;
  const maxLen = document.getElementById('rw-max-len') as HTMLInputElement;
  const starts = document.getElementById('rw-starts') as HTMLInputElement;
  const ends = document.getElementById('rw-ends') as HTMLInputElement;
  const include = document.getElementById('rw-include') as HTMLInputElement;
  const exclude = document.getElementById('rw-exclude') as HTMLInputElement;
  const syllables = document.getElementById('rw-syllables') as HTMLSelectElement;
  const format = document.getElementById('rw-format') as HTMLSelectElement;
  const unique = document.getElementById('rw-unique') as HTMLInputElement;
  const output = document.getElementById('rw-output') as HTMLTextAreaElement;
  const generateBtn = document.getElementById('rw-generate') as HTMLButtonElement;
  const clearBtn = document.getElementById('rw-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('rw-copy') as HTMLButtonElement;
  const downloadBtn = document.getElementById('rw-download') as HTMLButtonElement;
  const stats = document.getElementById('rw-stats') as HTMLElement;

  const nouns = 'apple table chair mountain river forest cloud dream light star moon sun wave storm flame peace truth brave noble swift calm bold wise kind fair strong free wild grace hope joy love trust faith dawn dusk pride glory honor power beauty wonder magic mystery adventure journey discovery freedom destiny harmony infinity garden flower bird song dance music art book word voice heart soul mind body life time day night spring summer autumn winter world earth sky sea lake hill valley desert island city village road path bridge tower castle palace temple garden park beach cliff glacier volcano canyon meadow orchard vineyard harvest blossom petal leaf branch root seed'.split(' ');
  const verbs = 'run jump swim fly sing dance write read speak listen think dream sleep wake eat drink laugh cry smile walk climb crawl dive float glide slide roll spin twist bend stretch reach grab hold release push pull throw catch kick punch fight build break fix create destroy grow shrink expand rise fall begin end start stop continue pause resume learn teach study play work rest explore discover invent design craft shape mold carve paint draw sketch color outline compose arrange organize plan prepare gather collect sort filter clean wash polish shine glow gleam sparkle shimmer'.split(' ');
  const adjectives = 'happy sad angry calm brave shy bold kind cruel wise foolish smart clever gentle rough smooth soft hard warm cold hot cool fresh stale bright dark light heavy light tiny huge small large tall short wide narrow thick thin deep shallow rich poor full empty open closed fast slow quick steady strong weak powerful fragile beautiful ugly pretty plain stunning gorgeous elegant rustic modern ancient vintage fresh classic simple complex easy difficult simple complex clear cloudy sharp dull round square flat curved straight long short high low near far early late new old young fresh antique'.split(' ');
  const adverbs = 'quickly slowly happily sadly angrily calmly bravely shyly boldly kindly wisely foolishly smartly cleverly gently roughly smoothly softly hardly warmly coldly hotly coolly freshly brightly darkly lightly heavily widely narrowly deeply shallowly richly poorly fully openly closedly fastly slowly quickly steadily strongly weakly powerfully beautifully uglily prettily plainly stunningly gorgeously elegantly rustically modernly anciently freshly classically simply complexly easily difficultly clearly cloudily sharply dully roundly squarely flatly curvedly straightly longly shortly highly newly oldly youngly freshly antiquesly'.split(' ');

  function getPool(): string[] {
    const cat = category.value;
    if (cat === 'nouns') return nouns;
    if (cat === 'verbs') return verbs;
    if (cat === 'adjectives') return adjectives;
    if (cat === 'adverbs') return adverbs;
    if (cat === 'mixed') return [...nouns, ...verbs, ...adjectives, ...adverbs];
    return [...nouns, ...verbs, ...adjectives, ...adverbs];
  }

  function countSyllables(word: string): number {
    word = word.toLowerCase();
    if (word.length <= 3) return 1;
    word = word.replace(/(?:[^laeiouy]es|ed|[^laeiouy]e)$/, '');
    word = word.replace(/^y/, '');
    const matches = word.match(/[aeiouy]{1,2}/g);
    return matches ? matches.length : 1;
  }

  function filterWords(words: string[]): string[] {
    const min = parseInt(minLen.value) || 0;
    const max = parseInt(maxLen.value) || 0;
    const startStr = starts.value.toLowerCase().trim();
    const endStr = ends.value.toLowerCase().trim();
    const incPattern = include.value.toLowerCase().trim();
    const excPattern = exclude.value.toLowerCase().trim();
    const sylFilter = parseInt(syllables.value);

    return words.filter(w => {
      if (min > 0 && w.length < min) return false;
      if (max > 0 && w.length > max) return false;
      if (startStr && !w.toLowerCase().startsWith(startStr)) return false;
      if (endStr && !w.toLowerCase().endsWith(endStr)) return false;
      if (incPattern && !w.toLowerCase().includes(incPattern)) return false;
      if (excPattern && w.toLowerCase().includes(excPattern)) return false;
      if (sylFilter > 0 && countSyllables(w) !== sylFilter) return false;
      return true;
    });
  }

  function doGenerate() {
    const n = Math.min(Math.max(parseInt(count.value) || 1, 1), 500);
    let pool = filterWords(getPool());
    if (pool.length === 0) {
      output.value = 'No words match your filters. Try adjusting them.';
      stats.textContent = '0 words';
      return;
    }

    let result: string[] = [];
    if (unique.checked) {
      const shuffled = [...pool].sort(() => Math.random() - 0.5);
      result = shuffled.slice(0, Math.min(n, shuffled.length));
    } else {
      for (let i = 0; i < n; i++) {
        result.push(pool[Math.floor(Math.random() * pool.length)]);
      }
    }

    let formatted = '';
    if (format.value === 'space') formatted = result.join(' ');
    else if (format.value === 'newline') formatted = result.join('\n');
    else if (format.value === 'csv') formatted = result.join(', ');
    else if (format.value === 'json') formatted = JSON.stringify(result, null, 2);
    else if (format.value === 'numbered') formatted = result.map((w, i) => (i + 1) + '. ' + w).join('\n');

    output.value = formatted;
    stats.textContent = result.length + ' word' + (result.length !== 1 ? 's' : '');
  }

  function doClear() {
    output.value = '';
    stats.textContent = '';
  }

  function doDownload() {
    if (!output.value) return;
    const fmt = format.value;
    const ext = fmt === 'json' ? 'json' : fmt === 'csv' ? 'csv' : 'txt';
    const blob = new Blob([output.value], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'random-words.' + ext;
    a.click();
    URL.revokeObjectURL(url);
  }

  generateBtn.addEventListener('click', doGenerate);
  clearBtn.addEventListener('click', doClear);
  downloadBtn.addEventListener('click', doDownload);
  category.addEventListener('change', doGenerate);
  count.addEventListener('input', doGenerate);
  minLen.addEventListener('input', doGenerate);
  maxLen.addEventListener('input', doGenerate);
  starts.addEventListener('input', doGenerate);
  ends.addEventListener('input', doGenerate);
  include.addEventListener('input', doGenerate);
  exclude.addEventListener('input', doGenerate);
  syllables.addEventListener('change', doGenerate);
  format.addEventListener('change', doGenerate);
  unique.addEventListener('change', doGenerate);

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); doGenerate(); }
  });

  doGenerate();
})();
</script>
