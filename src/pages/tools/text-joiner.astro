---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="text-joiner">
  <div class="tj-tool">
    <!-- Input Section -->
    <div class="card-glass p-5 sm:p-6 mb-4 relative overflow-hidden">
      <div class="pointer-events-none absolute -right-16 -top-16 h-32 w-32 rounded-full bg-cyan-500/10 blur-3xl"></div>
      <div class="relative z-10">
        <div class="flex items-center justify-between mb-3">
          <label for="tj-input" class="text-body font-semibold flex items-center gap-2">
            <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h12"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 17h6"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 12v8"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 12l-3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 12l3 3"/></svg>
            Input Lines / Fragments
          </label>
          <div class="flex items-center gap-2">
            <span id="tj-line-count" class="text-tiny text-txt-muted font-mono">0 lines</span>
            <button id="tj-clear-btn" class="btn-ghost px-3 py-1.5 text-tiny rounded-lg" title="Clear text">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              Clear
            </button>
          </div>
        </div>
        <textarea id="tj-input" class="tool-textarea min-h-[160px] w-full" placeholder="Enter text fragments, one per line...&#10;apple&#10;banana&#10;cherry" aria-label="Input text lines to join" autocomplete="off" spellcheck="false"></textarea>
      </div>
    </div>

    <!-- Separator Mode Buttons -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/></svg>
          Join Separator
        </h3>
        <span class="text-tiny text-txt-muted hidden sm:inline">12 separators</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5" id="tj-buttons">
        <button class="tj-btn active" data-sep=", " title="Comma + space">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5h14M5 12h14M5 19h6"/></svg>
          <span class="tj-btn-label">Comma + Space</span>
        </button>
        <button class="tj-btn" data-sep="," title="Comma only">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 5h14M5 12h14M5 19h6"/></svg>
          <span class="tj-btn-label">Comma</span>
        </button>
        <button class="tj-btn" data-sep=" " title="Space">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16"/></svg>
          <span class="tj-btn-label">Space</span>
        </button>
        <button class="tj-btn" data-sep="\n" title="Newline">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 18h16M4 12h8"/></svg>
          <span class="tj-btn-label">Newline</span>
        </button>
        <button class="tj-btn" data-sep=" | " title="Pipe + spaces">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v18M15 3v18"/></svg>
          <span class="tj-btn-label">Pipe |</span>
        </button>
        <button class="tj-btn" data-sep=" - " title="Hyphen + spaces">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14"/></svg>
          <span class="tj-btn-label">Hyphen</span>
        </button>
        <button class="tj-btn" data-sep="; " title="Semicolon + space">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="9" r="1"/><circle cx="12" cy="15" r="1"/></svg>
          <span class="tj-btn-label">Semicolon</span>
        </button>
        <button class="tj-btn" data-sep=" & " title="Ampersand + spaces">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 8l4 4 4-4M7 16l4-4 4 4"/></svg>
          <span class="tj-btn-label">Ampersand</span>
        </button>
        <button class="tj-btn" data-sep=" / " title="Slash + spaces">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 4l-4 16"/></svg>
          <span class="tj-btn-label">Slash</span>
        </button>
        <button class="tj-btn" data-sep=" + " title="Plus + spaces">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14"/></svg>
          <span class="tj-btn-label">Plus</span>
        </button>
        <button class="tj-btn" data-sep=" :: " title="Double colon + spaces">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="1"/><circle cx="12" cy="16" r="1"/></svg>
          <span class="tj-btn-label">Double Colon</span>
        </button>
        <button class="tj-btn" data-sep="custom" title="Custom separator">
          <svg class="tj-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path stroke-linecap="round" stroke-linejoin="round" d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
          <span class="tj-btn-label">Custom</span>
        </button>
      </div>
      <!-- Custom separator input -->
      <div id="tj-custom-wrap" class="mt-3 hidden">
        <label class="text-tiny font-semibold text-txt-muted mb-1 block">Custom separator:</label>
        <input id="tj-custom-sep" type="text" class="tool-textarea w-full py-2 px-3 text-small" placeholder="Enter custom separator..." value=" - " />
      </div>
    </div>

    <!-- Options Panel -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <h3 class="text-body font-semibold mb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>
        Options
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="tj-opt-trim" checked class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Trim whitespace</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="tj-opt-skip-empty" checked class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Skip empty lines</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="tj-opt-quotes" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Wrap in quotes</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="tj-opt-number" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Number items</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="tj-opt-dedup" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Remove duplicates</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer rounded-lg bg-surface-light-alt/50 px-3 py-2.5 dark:bg-surface-dark-alt/50">
          <input type="checkbox" id="tj-opt-sort" class="accent-brand-500" />
          <span class="text-small text-txt-light dark:text-txt-dark">Sort alphabetically</span>
        </label>
      </div>
    </div>

    <!-- Result Section -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Joined Result
        </h3>
        <div class="flex items-center gap-2">
          <span id="tj-status" class="text-tiny text-txt-muted"></span>
          <button id="tj-copy-btn" class="btn-primary px-4 py-2 text-small rounded-xl" disabled title="Copy result (Ctrl+Shift+C)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>
      <div id="tj-empty" class="flex flex-col items-center justify-center py-12 text-center">
        <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-light-alt text-brand-400 dark:bg-surface-dark-alt dark:text-brand-500">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h12"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 17h6"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 12v8"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 12l-3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M18 12l3 3"/></svg>
        </div>
        <p class="text-small text-txt-muted">Enter text above and select a separator to see the joined result</p>
      </div>
      <div id="tj-result-wrap" class="hidden">
        <div id="tj-result" class="tool-textarea min-h-[120px] w-full bg-surface-light-alt/50 dark:bg-surface-dark-alt/50 font-mono text-small leading-relaxed whitespace-pre-wrap break-words cursor-text" role="textbox" aria-label="Joined text result" tabindex="0"></div>
        <div class="mt-3 flex items-center justify-between text-tiny text-txt-muted">
          <span id="tj-result-count"></span>
          <span id="tj-active-sep" class="badge-brand"></span>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <h3 class="text-body font-semibold mb-3 flex items-center gap-2">
        <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v18h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 16v-5M12 16V7M17 16v-3"/></svg>
        Join Stats
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Input Lines</div>
          <div id="tj-stat-input" class="text-body font-bold text-txt-light dark:text-txt-dark">0</div>
        </div>
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Joined Items</div>
          <div id="tj-stat-joined" class="text-body font-bold text-txt-light dark:text-txt-dark">0</div>
        </div>
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Skipped</div>
          <div id="tj-stat-skipped" class="text-body font-bold text-txt-light dark:text-txt-dark">0</div>
        </div>
        <div class="rounded-lg bg-surface-light-alt p-3 text-center dark:bg-surface-dark-alt">
          <div class="text-tiny text-txt-muted">Result Length</div>
          <div id="tj-stat-length" class="text-body font-bold text-brand-600 dark:text-brand-300">0</div>
        </div>
      </div>
    </div>

    <!-- Keyboard shortcuts help -->
    <div class="card-glass p-4 mb-4">
      <details>
        <summary class="cursor-pointer text-small font-semibold text-txt-muted flex items-center gap-2 list-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"/></svg>
          Keyboard Shortcuts
          <svg class="h-4 w-4 transition-transform ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-tiny text-txt-muted">
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Copy result</span><kbd class="kbd">Ctrl+Shift+C</kbd></div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Clear text</span><kbd class="kbd">Ctrl+Shift+K</kbd></div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Focus input</span><kbd class="kbd">Ctrl+I</kbd></div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50"><span>Toggle live preview</span><kbd class="kbd">Ctrl+L</kbd></div>
        </div>
      </details>
    </div>
  </div>

  <ToolSections slug="text-joiner" />
</ToolLayout>

<style>
  .tj-btn {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 12px 8px; border-radius: 12px; border: 1px solid var(--color-border);
    background: var(--color-surface); cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); min-height: 64px;
    position: relative; overflow: hidden;
  }
  .tj-btn::before {
    content: ''; position: absolute; inset: 0;
    background: var(--color-brand-gradient); opacity: 0;
    transition: opacity 0.25s ease; z-index: 0;
  }
  .tj-btn > * { position: relative; z-index: 1; }
  .tj-btn:hover {
    border-color: var(--color-brand); transform: translateY(-2px);
    box-shadow: 0 4px 16px -4px rgba(124, 58, 237, 0.2);
  }
  .tj-btn:active { transform: translateY(0) scale(0.98); }
  .tj-btn.active::before { opacity: 1; }
  .tj-btn.active { color: #fff; border-color: transparent; }
  .tj-btn.active .tj-btn-icon, .tj-btn.active .tj-btn-label { color: #fff; stroke: #fff; }
  .tj-btn-icon { width: 20px; height: 20px; color: var(--color-brand); }
  .tj-btn-label { font-size: 0.75rem; font-weight: 600; color: var(--color-text-muted); text-align: center; line-height: 1.2; }
  .tj-btn:hover .tj-btn-label { color: var(--color-text); }
  .dark .tj-btn { background: var(--color-surface); }
  .dark .tj-btn-icon { color: var(--color-brand); }
  .kbd {
    display: inline-flex; align-items: center; padding: 2px 8px;
    border-radius: 6px; border: 1px solid var(--color-border);
    background: var(--color-surface-alt); font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem; font-weight: 600; color: var(--color-text);
  }
  details summary::-webkit-details-marker { display: none; }
  details summary::marker { content: ''; }
  @media (max-width: 358px) {
    .tj-btn { padding: 10px 6px; min-height: 56px; }
    .tj-btn-icon { width: 18px; height: 18px; }
    .tj-btn-label { font-size: 0.6875rem; }
  }
</style>

<script is:inline>
(function () {
  var input = document.getElementById('tj-input');
  var lineCount = document.getElementById('tj-line-count');
  var clearBtn = document.getElementById('tj-clear-btn');
  var copyBtn = document.getElementById('tj-copy-btn');
  var emptyState = document.getElementById('tj-empty');
  var resultWrap = document.getElementById('tj-result-wrap');
  var resultEl = document.getElementById('tj-result');
  var resultCount = document.getElementById('tj-result-count');
  var activeSepEl = document.getElementById('tj-active-sep');
  var statusEl = document.getElementById('tj-status');
  var buttons = document.querySelectorAll('.tj-btn');
  var customWrap = document.getElementById('tj-custom-wrap');
  var customSep = document.getElementById('tj-custom-sep');
  var optTrim = document.getElementById('tj-opt-trim');
  var optSkipEmpty = document.getElementById('tj-opt-skip-empty');
  var optQuotes = document.getElementById('tj-opt-quotes');
  var optNumber = document.getElementById('tj-opt-number');
  var optDedup = document.getElementById('tj-opt-dedup');
  var optSort = document.getElementById('tj-opt-sort');
  var statInput = document.getElementById('tj-stat-input');
  var statJoined = document.getElementById('tj-stat-joined');
  var statSkipped = document.getElementById('tj-stat-skipped');
  var statLength = document.getElementById('tj-stat-length');
  var currentResult = '';
  var activeBtn = document.querySelector('.tj-btn.active');
  var currentSep = ', ';

  var sepLabels = {
    ', ': 'Comma + Space', ',': 'Comma', ' ': 'Space', '\\n': 'Newline',
    ' | ': 'Pipe', ' - ': 'Hyphen', '; ': 'Semicolon', ' & ': 'Ampersand',
    ' / ': 'Slash', ' + ': 'Plus', ' :: ': 'Double Colon', 'custom': 'Custom'
  };

  function getSeparator() {
    if (activeBtn && activeBtn.getAttribute('data-sep') === 'custom') {
      return customSep.value;
    }
    if (activeBtn) {
      var s = activeBtn.getAttribute('data-sep');
      return s === '\\n' ? '\n' : s;
    }
    return ', ';
  }

  function joinText() {
    var text = input.value;
    if (!text.trim()) {
      clearResult();
      return;
    }
    var lines = text.split('\n');
    var totalInput = lines.length;
    var skipped = 0;
    var items = [];

    lines.forEach(function (line) {
      var processed = optTrim.checked ? line.trim() : line;
      if (optSkipEmpty.checked && !processed.trim()) {
        skipped++;
        return;
      }
      items.push(processed);
    });

    if (optDedup.checked) {
      var seen = {};
      var unique = [];
      items.forEach(function (item) {
        var key = optTrim.checked ? item.trim() : item;
        if (!seen[key]) {
          seen[key] = true;
          unique.push(item);
        } else {
          skipped++;
        }
      });
      items = unique;
    }

    if (optSort.checked) {
      items.sort(function (a, b) {
        return a.localeCompare(b);
      });
    }

    if (optQuotes.checked) {
      items = items.map(function (item) {
        return '"' + item.replace(/"/g, '\\"') + '"';
      });
    }

    if (optNumber.checked) {
      items = items.map(function (item, i) {
        return (i + 1) + '. ' + item;
      });
    }

    var sep = getSeparator();
    var result = items.join(sep);

    currentResult = result;
    resultEl.textContent = result;
    emptyState.classList.add('hidden');
    resultWrap.classList.remove('hidden');
    resultWrap.classList.add('animate-slide-up');
    resultCount.textContent = result.length + ' characters';
    var sepKey = activeBtn ? activeBtn.getAttribute('data-sep') : ', ';
    activeSepEl.textContent = sepLabels[sepKey] || 'Custom';
    copyBtn.disabled = false;
    statusEl.textContent = '✓ Joined';
    statusEl.classList.add('text-green-600', 'dark:text-green-400');
    statInput.textContent = totalInput;
    statJoined.textContent = items.length;
    statSkipped.textContent = skipped;
    statLength.textContent = result.length;
    setTimeout(function () { resultWrap.classList.remove('animate-slide-up'); }, 500);
  }

  function clearResult() {
    currentResult = '';
    resultEl.textContent = '';
    emptyState.classList.remove('hidden');
    resultWrap.classList.add('hidden');
    copyBtn.disabled = true;
    statusEl.textContent = '';
    activeSepEl.textContent = '';
    statInput.textContent = '0';
    statJoined.textContent = '0';
    statSkipped.textContent = '0';
    statLength.textContent = '0';
  }

  function updateLineCount() {
    var lines = input.value.split('\n').length;
    lineCount.textContent = lines + ' lines';
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (activeBtn) activeBtn.classList.remove('active');
      btn.classList.add('active');
      activeBtn = btn;
      if (btn.getAttribute('data-sep') === 'custom') {
        customWrap.classList.remove('hidden');
        customSep.focus();
      } else {
        customWrap.classList.add('hidden');
      }
      joinText();
    });
  });

  customSep.addEventListener('input', function () {
    if (activeBtn && activeBtn.getAttribute('data-sep') === 'custom') {
      joinText();
    }
  });

  [optTrim, optSkipEmpty, optQuotes, optNumber, optDedup, optSort].forEach(function (opt) {
    opt.addEventListener('change', joinText);
  });

  clearBtn.addEventListener('click', function () {
    input.value = '';
    updateLineCount();
    clearResult();
    input.focus();
  });

  copyBtn.addEventListener('click', function () {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult).then(function () {
      var orig = copyBtn.innerHTML;
      copyBtn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>Copied!</span>';
      copyBtn.classList.add('!bg-green-500');
      setTimeout(function () {
        copyBtn.innerHTML = orig;
        copyBtn.classList.remove('!bg-green-500');
      }, 2000);
    });
  });

  input.addEventListener('input', function () {
    updateLineCount();
    joinText();
  });

  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'C') {
      e.preventDefault();
      if (!copyBtn.disabled) copyBtn.click();
    } else if (e.ctrlKey && e.shiftKey && e.key === 'K') {
      e.preventDefault();
      clearBtn.click();
    } else if (e.ctrlKey && e.key === 'i') {
      e.preventDefault();
      input.focus();
    }
  });

  updateLineCount();
  joinText();
})();
</script>
