---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="lorem-ipsum-generator">
  <div class="space-y-4">
    <div class="card-glass p-4 sm:p-6">
      <h2 class="mb-4 text-h4 font-bold">Lorem Ipsum Generator</h2>

      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="li-unit" class="mb-1.5 block text-small font-semibold text-txt-muted">Unit</label>
            <select id="li-unit" class="tool-input min-h-[48px] w-full" aria-label="Generation unit">
              <option value="paragraphs">Paragraphs</option>
              <option value="sentences">Sentences</option>
              <option value="words">Words</option>
            </select>
          </div>
          <div>
            <label for="li-count" class="mb-1.5 block text-small font-semibold text-txt-muted">Count</label>
            <input id="li-count" type="number" class="tool-input min-h-[48px] w-full" value="5" min="1" max="1000" aria-label="Count" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="li-variant" class="mb-1.5 block text-small font-semibold text-txt-muted">Variant</label>
            <select id="li-variant" class="tool-input min-h-[48px] w-full" aria-label="Text variant">
              <option value="classic">Classic Latin</option>
              <option value="english">English Placeholder</option>
              <option value="mixed">Mixed Lorem/English</option>
            </select>
          </div>
          <div>
            <label for="li-format" class="mb-1.5 block text-small font-semibold text-txt-muted">Output Format</label>
            <select id="li-format" class="tool-input min-h-[48px] w-full" aria-label="Output format">
              <option value="plain">Plain text</option>
              <option value="html-p">HTML (&lt;p&gt; tags)</option>
              <option value="html-li">HTML (&lt;li&gt; list)</option>
            </select>
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <label class="flex items-center gap-2 rounded-xl border border-border-light bg-surface-light px-3 py-2 text-small cursor-pointer transition-all hover:border-brand-300 dark:border-border-dark dark:bg-surface-dark">
            <input type="checkbox" id="li-start-classic" class="accent-brand-500" checked />
            <span>Start with "Lorem ipsum"</span>
          </label>
        </div>

        <div class="flex flex-wrap gap-2">
          <button id="li-generate" class="btn-primary px-5 py-2.5 text-small">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Generate
            <kbd class="ml-1 hidden rounded bg-white/20 px-1.5 py-0.5 text-tiny sm:inline">Ctrl+Enter</kbd>
          </button>
          <button id="li-clear" class="btn-ghost px-5 py-2.5 text-small">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Clear
          </button>
        </div>
      </div>
    </div>

    <div class="card-glass p-4 sm:p-6">
      <div class="mb-3 flex items-center justify-between gap-2">
        <h3 class="text-body font-semibold">Generated Text</h3>
        <div class="flex items-center gap-2">
          <span id="li-stats" class="text-small text-txt-muted"></span>
          <button id="li-copy" class="btn-secondary px-4 py-2 text-small" data-copy-target="li-output">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            Copy
          </button>
          <button id="li-download" class="btn-ghost px-4 py-2 text-small">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path stroke-linecap="round" stroke-linejoin="round" d="M7 10l5 5 5-5"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 15V3"/></svg>
            Download
          </button>
        </div>
      </div>
      <textarea id="li-output" class="tool-textarea min-h-[200px] w-full" readonly placeholder="Lorem ipsum text will appear here..." aria-label="Generated text"></textarea>
    </div>
  </div>

  <ToolSections slug="lorem-ipsum-generator" />
</ToolLayout>

<script>
(function() {
  const unit = document.getElementById('li-unit') as HTMLSelectElement;
  const count = document.getElementById('li-count') as HTMLInputElement;
  const variant = document.getElementById('li-variant') as HTMLSelectElement;
  const format = document.getElementById('li-format') as HTMLSelectElement;
  const startClassic = document.getElementById('li-start-classic') as HTMLInputElement;
  const output = document.getElementById('li-output') as HTMLTextAreaElement;
  const generateBtn = document.getElementById('li-generate') as HTMLButtonElement;
  const clearBtn = document.getElementById('li-clear') as HTMLButtonElement;
  const copyBtn = document.getElementById('li-copy') as HTMLButtonElement;
  const downloadBtn = document.getElementById('li-download') as HTMLButtonElement;
  const stats = document.getElementById('li-stats') as HTMLElement;

  const latinWords = 'lorem ipsum dolor sit amet consectetur adipiscing elit sed do eiusmod tempor incididunt ut labore et dolore magna aliqua enim ad minim veniam quis nostrud exercitation ullamco laboris nisi aliquip ex ea commodo consequat duis aute irure in reprehenderit voluptate velit esse cillum eu fugiat nulla pariatur excepteur sint occaecat cupidatat non proident sunt culpa qui officia deserunt mollit anim id est laborum'.split(' ');
  const englishWords = 'the quick brown fox jumps over lazy dog hello world this is placeholder text for your design mockup website template content area paragraph sample data lorem ipsum alternative free online generator tool browser client side processing private secure fast modern beautiful interface'.split(' ');

  function randomWord(pool: string[]): string {
    return pool[Math.floor(Math.random() * pool.length)];
  }

  function randomSentence(pool: string[], minWords = 8, maxWords = 20): string {
    const len = Math.floor(Math.random() * (maxWords - minWords + 1)) + minWords;
    let words: string[] = [];
    for (let i = 0; i < len; i++) words.push(randomWord(pool));
    let sentence = words.join(' ');
    sentence = sentence.charAt(0).toUpperCase() + sentence.slice(1) + '.';
    return sentence;
  }

  function randomParagraph(pool: string[], minSent = 3, maxSent = 7): string {
    const len = Math.floor(Math.random() * (maxSent - minSent + 1)) + minSent;
    let sentences: string[] = [];
    for (let i = 0; i < len; i++) sentences.push(randomSentence(pool));
    return sentences.join(' ');
  }

  function getPool(): string[] {
    if (variant.value === 'english') return englishWords;
    if (variant.value === 'mixed') {
      return Math.random() > 0.5 ? latinWords : englishWords;
    }
    return latinWords;
  }

  function doGenerate() {
    const n = Math.min(Math.max(parseInt(count.value) || 1, 1), 1000);
    const pool = getPool();
    let result = '';

    if (unit.value === 'paragraphs') {
      let paras: string[] = [];
      for (let i = 0; i < n; i++) {
        if (i === 0 && startClassic.checked) {
          paras.push('Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.');
        } else {
          paras.push(randomParagraph(pool));
        }
      }
      if (format.value === 'html-p') {
        result = paras.map(p => '<p>' + p + '</p>').join('\n');
      } else if (format.value === 'html-li') {
        result = '<ul>\n' + paras.map(p => '  <li>' + p + '</li>').join('\n') + '\n</ul>';
      } else {
        result = paras.join('\n\n');
      }
    } else if (unit.value === 'sentences') {
      let sentences: string[] = [];
      for (let i = 0; i < n; i++) {
        if (i === 0 && startClassic.checked) {
          sentences.push('Lorem ipsum dolor sit amet, consectetur adipiscing elit.');
        } else {
          sentences.push(randomSentence(pool));
        }
      }
      if (format.value === 'html-li') {
        result = '<ul>\n' + sentences.map(s => '  <li>' + s + '</li>').join('\n') + '\n</ul>';
      } else if (format.value === 'html-p') {
        result = '<p>' + sentences.join(' ') + '</p>';
      } else {
        result = sentences.join(' ');
      }
    } else {
      let words: string[] = [];
      for (let i = 0; i < n; i++) {
        if (i === 0 && startClassic.checked && i < latinWords.length) {
          words.push(latinWords[i]);
        } else {
          words.push(randomWord(pool));
        }
      }
      result = words.join(' ');
      if (format.value === 'html-p') result = '<p>' + result + '</p>';
      else if (format.value === 'html-li') result = '<ul>\n  <li>' + words.join('</li>\n  <li>') + '</li>\n</ul>';
    }

    output.value = result;
    const charCount = result.length;
    const wordCount = result.trim().split(/\s+/).filter(Boolean).length;
    const readTime = Math.ceil(wordCount / 200);
    stats.textContent = charCount + ' chars · ' + wordCount + ' words · ~' + readTime + ' min read';
  }

  function doClear() {
    output.value = '';
    stats.textContent = '';
  }

  function doDownload() {
    if (!output.value) return;
    const blob = new Blob([output.value], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'lorem-ipsum.txt';
    a.click();
    URL.revokeObjectURL(url);
  }

  generateBtn.addEventListener('click', doGenerate);
  clearBtn.addEventListener('click', doClear);
  downloadBtn.addEventListener('click', doDownload);
  unit.addEventListener('change', doGenerate);
  variant.addEventListener('change', doGenerate);
  format.addEventListener('change', doGenerate);
  startClassic.addEventListener('change', doGenerate);
  count.addEventListener('input', doGenerate);

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); doGenerate(); }
  });

  doGenerate();
})();
</script>
