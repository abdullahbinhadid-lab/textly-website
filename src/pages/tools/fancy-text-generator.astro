---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="fancy-text-generator">
  <div class="ft-tool">
    <!-- Input Section -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-3">
        <label for="ft-input" class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
          Your Text
        </label>
        <div class="flex items-center gap-2">
          <span id="ft-char-count" class="text-tiny text-txt-muted font-mono">0 chars</span>
          <button id="ft-clear-btn" class="btn-ghost px-3 py-1.5 text-tiny rounded-lg" title="Clear text (Ctrl+Shift+K)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Clear
          </button>
        </div>
      </div>
      <textarea id="ft-input" class="tool-textarea min-h-[80px] w-full" placeholder="Type your name, a message, or any text..." aria-label="Input text to stylize" autocomplete="off" spellcheck="false"></textarea>
    </div>

    <!-- Fancy Style Results Grid -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
          Fancy Text Styles
        </h3>
        <span class="text-tiny text-txt-muted hidden sm:inline">Click any card to copy</span>
      </div>

      <!-- Empty state -->
      <div id="ft-empty" class="flex flex-col items-center justify-center py-12 text-center">
        <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-light-alt text-brand-400 dark:bg-surface-dark-alt dark:text-brand-500">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
        </div>
        <p class="text-small text-txt-muted">Type text above to see all 12 fancy styles instantly</p>
      </div>

      <!-- Style cards grid -->
      <div id="ft-styles-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="ft-card" data-style="bold" tabindex="0" role="button" aria-label="Bold style">
          <div class="ft-card-header">
            <span class="ft-card-name">Bold</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-bold"></div>
        </div>
        <div class="ft-card" data-style="italic" tabindex="0" role="button" aria-label="Italic style">
          <div class="ft-card-header">
            <span class="ft-card-name">Italic</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-italic"></div>
        </div>
        <div class="ft-card" data-style="bold-italic" tabindex="0" role="button" aria-label="Bold Italic style">
          <div class="ft-card-header">
            <span class="ft-card-name">Bold Italic</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-bold-italic"></div>
        </div>
        <div class="ft-card" data-style="script" tabindex="0" role="button" aria-label="Script style">
          <div class="ft-card-header">
            <span class="ft-card-name">Script</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-script"></div>
        </div>
        <div class="ft-card" data-style="bold-script" tabindex="0" role="button" aria-label="Bold Script style">
          <div class="ft-card-header">
            <span class="ft-card-name">Bold Script</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-bold-script"></div>
        </div>
        <div class="ft-card" data-style="fraktur" tabindex="0" role="button" aria-label="Fraktur style">
          <div class="ft-card-header">
            <span class="ft-card-name">Fraktur</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-fraktur"></div>
        </div>
        <div class="ft-card" data-style="double-struck" tabindex="0" role="button" aria-label="Double-struck style">
          <div class="ft-card-header">
            <span class="ft-card-name">Double-struck</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-double-struck"></div>
        </div>
        <div class="ft-card" data-style="monospace" tabindex="0" role="button" aria-label="Monospace style">
          <div class="ft-card-header">
            <span class="ft-card-name">Monospace</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-monospace"></div>
        </div>
        <div class="ft-card" data-style="sans-bold" tabindex="0" role="button" aria-label="Sans-serif Bold style">
          <div class="ft-card-header">
            <span class="ft-card-name">Sans-serif Bold</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-sans-bold"></div>
        </div>
        <div class="ft-card" data-style="circled" tabindex="0" role="button" aria-label="Circled style">
          <div class="ft-card-header">
            <span class="ft-card-name">Circled</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-circled"></div>
        </div>
        <div class="ft-card" data-style="fullwidth" tabindex="0" role="button" aria-label="Fullwidth style">
          <div class="ft-card-header">
            <span class="ft-card-name">Fullwidth</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-fullwidth"></div>
        </div>
        <div class="ft-card" data-style="smallcaps" tabindex="0" role="button" aria-label="Small Caps style">
          <div class="ft-card-header">
            <span class="ft-card-name">Small Caps</span>
            <span class="ft-card-copy">Copy</span>
          </div>
          <div class="ft-card-text ft-text-smallcaps"></div>
        </div>
      </div>

      <!-- Status bar -->
      <div id="ft-status-bar" class="hidden mt-4 flex items-center justify-between text-tiny text-txt-muted">
        <span id="ft-status-text"></span>
        <span class="text-txt-muted">12 styles generated</span>
      </div>
    </div>

    <!-- Keyboard shortcuts help -->
    <div class="card-glass p-4 mb-4">
      <details>
        <summary class="cursor-pointer text-small font-semibold text-txt-muted flex items-center gap-2 list-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"/></svg>
          Keyboard Shortcuts
          <svg class="h-4 w-4 transition-transform ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-tiny text-txt-muted">
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Focus input</span>
            <kbd class="kbd">Ctrl+I</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Clear text</span>
            <kbd class="kbd">Ctrl+Shift+K</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Copy first style (Bold)</span>
            <kbd class="kbd">Ctrl+B</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Navigate cards with Tab</span>
            <kbd class="kbd">Tab</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Copy focused card</span>
            <kbd class="kbd">Enter</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Paste from clipboard</span>
            <kbd class="kbd">Ctrl+V</kbd>
          </div>
        </div>
      </details>
    </div>
  </div>

  <ToolSections slug="fancy-text-generator" />
</ToolLayout>

<style>
  .ft-card {
    border-radius: 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 14px 16px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  .ft-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--color-brand-gradient);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .ft-card:hover {
    border-color: var(--color-brand);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px -4px rgba(124, 58, 237, 0.18);
  }
  .ft-card:hover::before { opacity: 1; }
  .ft-card:active { transform: translateY(0) scale(0.99); }
  .ft-card:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .ft-card.copied {
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.05);
  }
  .ft-card.copied .ft-card-copy::after {
    content: ' ✓';
    color: #22c55e;
  }
  .ft-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .ft-card-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ft-card-copy {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-brand);
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  .ft-card:hover .ft-card-copy { opacity: 1; }
  .ft-card-text {
    font-size: 1.0625rem;
    line-height: 1.5;
    word-break: break-word;
    min-height: 1.5em;
    color: var(--color-text);
  }
  .dark .ft-card { background: var(--color-surface); }
  .kbd {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text);
  }
  details summary::-webkit-details-marker { display: none; }
  details summary::marker { content: ''; }
  @media (max-width: 358px) {
    .ft-card { padding: 12px 14px; }
    .ft-card-text { font-size: 0.9375rem; }
  }
</style>

