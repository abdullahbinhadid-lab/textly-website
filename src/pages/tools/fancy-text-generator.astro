    }
  };

  var styleClassMap = {
    bold: 'ft-text-bold', italic: 'ft-text-italic', 'bold-italic': 'ft-text-bold-italic',
    script: 'ft-text-script', 'bold-script': 'ft-text-bold-script', fraktur: 'ft-text-fraktur',
    'double-struck': 'ft-text-double-struck', monospace: 'ft-text-monospace',
    'sans-bold': 'ft-text-sans-bold', circled: 'ft-text-circled',
    fullwidth: 'ft-text-fullwidth', smallcaps: 'ft-text-smallcaps'
  };

  function convert(text, style) {
    var map = maps[style];
    if (!map) return text;
    var result = '';
    for (var i = 0; i < text.length; i++) {
      var ch = text[i];
      result += (map[ch] !== undefined) ? map[ch] : ch;
    }
    return result;
  }

  function updateAll() {
    var text = input.value;
    charCount.textContent = text.length + ' chars';

    if (!text.trim()) {
      emptyState.classList.remove('hidden');
      stylesGrid.classList.add('hidden');
      statusBar.classList.add('hidden');
      return;
    }

    emptyState.classList.add('hidden');
    stylesGrid.classList.remove('hidden');
    stylesGrid.classList.add('animate-slide-up');
    statusBar.classList.remove('hidden');
    statusText.textContent = '✓ 12 styles generated — click any card to copy';
    statusText.classList.add('text-green-600', 'dark:text-green-400');

    cards.forEach(function (card) {
      var style = card.getAttribute('data-style');
      var className = styleClassMap[style];
      var el = card.querySelector('.' + className);
      if (el) {
        var converted = convert(text, style);
        el.textContent = converted;
      }
      card.classList.remove('copied');
    });

    setTimeout(function () {
      stylesGrid.classList.remove('animate-slide-up');
    }, 500);
  }

  function copyCard(card) {
    var style = card.getAttribute('data-style');
    var className = styleClassMap[style];
    var el = card.querySelector('.' + className);
    if (!el) return;
    var text = el.textContent;
    navigator.clipboard.writeText(text).then(function () {
      cards.forEach(function (c) { c.classList.remove('copied'); });
      card.classList.add('copied');
      var copyEl = card.querySelector('.ft-card-copy');
      var origText = copyEl.textContent;
      copyEl.textContent = 'Copied!';
      setTimeout(function () {
        card.classList.remove('copied');
        copyEl.textContent = origText;
      }, 2000);
    });
  }

  cards.forEach(function (card) {
    card.addEventListener('click', function () { copyCard(card); });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        copyCard(card);
      }
    });
  });

  clearBtn.addEventListener('click', function () {
    input.value = '';
    updateAll();
    input.focus();
  });

  input.addEventListener('input', updateAll);

  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'K') {
      e.preventDefault();
      clearBtn.click();
    } else if (e.ctrlKey && e.key === 'i') {
      e.preventDefault();
      input.focus();
    } else if (e.ctrlKey && e.key === 'b' && document.activeElement !== input) {
      e.preventDefault();
      var firstCard = document.querySelector('.ft-card');
      if (firstCard) copyCard(firstCard);
    }
  });

  updateAll();
})();
</script>
