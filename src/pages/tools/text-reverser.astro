---
import ToolLayout from '../../layouts/ToolLayout.astro';
import ToolSections from '../../components/ToolSections.astro';
---

<ToolLayout slug="text-reverser">
  <div class="tr-tool">
    <!-- Input Section -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-3">
        <label for="tr-input" class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h14l-3-3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16H7l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16l-3-3"/></svg>
          Your Text
        </label>
        <div class="flex items-center gap-2">
          <span id="tr-char-count" class="text-tiny text-txt-muted font-mono">0 chars</span>
          <button id="tr-clear-btn" class="btn-ghost px-3 py-1.5 text-tiny rounded-lg" title="Clear text (Ctrl+Shift+K)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"/><path stroke-linecap="round" stroke-linejoin="round" d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            Clear
          </button>
        </div>
      </div>
      <textarea id="tr-input" class="tool-textarea min-h-[120px] w-full" placeholder="Type or paste your text here..." aria-label="Input text to reverse" autocomplete="off" spellcheck="false"></textarea>
    </div>

    <!-- Reverse Mode Buttons -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h14l-3-3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16H7l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16l-3-3"/></svg>
          Choose a Reverse Mode
        </h3>
        <span class="text-tiny text-txt-muted hidden sm:inline">12 modes available</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5" id="tr-buttons">
        <button class="tr-btn" data-mode="chars" title="Reverse all characters">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h14l-3-3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16H7l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16l-3-3"/></svg>
          <span class="tr-btn-label">Reverse Chars</span>
        </button>
        <button class="tr-btn" data-mode="words" title="Reverse word order">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
          <span class="tr-btn-label">Reverse Words</span>
        </button>
        <button class="tr-btn" data-mode="lines" title="Reverse line order">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h18M3 18h18"/></svg>
          <span class="tr-btn-label">Reverse Lines</span>
        </button>
        <button class="tr-btn" data-mode="wordschars" title="Reverse words and characters">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8H7l3-3M21 8l-3 3M3 16h14l-3 3M3 16l3-3"/></svg>
          <span class="tr-btn-label">Words + Chars</span>
        </button>
        <button class="tr-btn" data-mode="mirror" title="Mirror text using Unicode">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/></svg>
          <span class="tr-btn-label">Mirror Text</span>
        </button>
        <button class="tr-btn" data-mode="upsidedown" title="Flip text upside down">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/></svg>
          <span class="tr-btn-label">Upside Down</span>
        </button>
        <button class="tr-btn" data-mode="eachword" title="Reverse characters in each word">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 4l-4 4 4 4M17 20l4-4-4-4M3 8h18M21 16H3"/></svg>
          <span class="tr-btn-label">Each Word</span>
        </button>
        <button class="tr-btn" data-mode="eachline" title="Reverse characters in each line">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18M3 12h18M3 18h18"/></svg>
          <span class="tr-btn-label">Each Line</span>
        </button>
        <button class="tr-btn" data-mode="shufflewords" title="Shuffle words randomly">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          <span class="tr-btn-label">Shuffle Words</span>
        </button>
        <button class="tr-btn" data-mode="shufflechars" title="Shuffle characters randomly">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          <span class="tr-btn-label">Shuffle Chars</span>
        </button>
        <button class="tr-btn" data-mode="interleave" title="Interleave characters from both ends">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12h18M3 6h18M3 18h18"/></svg>
          <span class="tr-btn-label">Interleave</span>
        </button>
        <button class="tr-btn" data-mode="scramble" title="Scramble middle letters of each word">
          <svg class="tr-btn-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
          <span class="tr-btn-label">Scramble Words</span>
        </button>
      </div>
    </div>

    <!-- Result Section -->
    <div class="card-glass p-5 sm:p-6 mb-4">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-body font-semibold flex items-center gap-2">
          <svg class="h-5 w-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          Result
        </h3>
        <div class="flex items-center gap-2">
          <span id="tr-status" class="text-tiny text-txt-muted"></span>
          <button id="tr-copy-btn" class="btn-primary px-4 py-2 text-small rounded-xl" disabled title="Copy result (Ctrl+Shift+C)">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <span>Copy</span>
          </button>
        </div>
      </div>
      <!-- Empty state -->
      <div id="tr-empty" class="flex flex-col items-center justify-center py-12 text-center">
        <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-surface-light-alt text-brand-400 dark:bg-surface-dark-alt dark:text-brand-500">
          <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8h14l-3-3"/><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16H7l3 3"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 16l-3-3"/></svg>
        </div>
        <p class="text-small text-txt-muted">Enter text above and select a reverse mode to see the result</p>
      </div>
      <!-- Result display -->
      <div id="tr-result-wrap" class="hidden">
        <div id="tr-result" class="tool-textarea min-h-[120px] w-full bg-surface-light-alt/50 dark:bg-surface-dark-alt/50 font-mono text-small leading-relaxed whitespace-pre-wrap break-words cursor-text" role="textbox" aria-label="Reversed text result" tabindex="0"></div>
        <div class="mt-3 flex items-center justify-between text-tiny text-txt-muted">
          <span id="tr-result-count"></span>
          <span id="tr-active-mode" class="badge-brand"></span>
        </div>
      </div>
    </div>

    <!-- Keyboard shortcuts help -->
    <div class="card-glass p-4 mb-4">
      <details>
        <summary class="cursor-pointer text-small font-semibold text-txt-muted flex items-center gap-2 list-none">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M8 12h.01M12 12h.01M16 12h.01M7 16h10"/></svg>
          Keyboard Shortcuts
          <svg class="h-4 w-4 transition-transform ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-tiny text-txt-muted">
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Reverse characters</span>
            <kbd class="kbd">Ctrl+R</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Reverse words</span>
            <kbd class="kbd">Ctrl+W</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Copy result</span>
            <kbd class="kbd">Ctrl+Shift+C</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Clear text</span>
            <kbd class="kbd">Ctrl+Shift+K</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Focus input</span>
            <kbd class="kbd">Ctrl+I</kbd>
          </div>
          <div class="flex items-center justify-between rounded-lg bg-surface-light-alt/50 px-3 py-2 dark:bg-surface-dark-alt/50">
            <span>Re-shuffle (when shuffle mode active)</span>
            <kbd class="kbd">Ctrl+D</kbd>
          </div>
        </div>
      </details>
    </div>
  </div>

  <ToolSections slug="text-reverser" />
</ToolLayout>

<style>
  .tr-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 12px 8px;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    min-height: 64px;
    position: relative;
    overflow: hidden;
  }
  .tr-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-brand-gradient);
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 0;
  }
  .tr-btn > * { position: relative; z-index: 1; }
  .tr-btn:hover {
    border-color: var(--color-brand);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px -4px rgba(124, 58, 237, 0.2);
  }
  .tr-btn:active { transform: translateY(0) scale(0.98); }
  .tr-btn.active::before { opacity: 1; }
  .tr-btn.active { color: #fff; border-color: transparent; }
  .tr-btn.active .tr-btn-icon,
  .tr-btn.active .tr-btn-label { color: #fff; stroke: #fff; }
  .tr-btn-icon {
    width: 20px;
    height: 20px;
    color: var(--color-brand);
  }
  .tr-btn-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.2;
  }
  .tr-btn:hover .tr-btn-label { color: var(--color-text); }
  .dark .tr-btn { background: var(--color-surface); }
  .dark .tr-btn-icon { color: var(--color-brand); }
  .kbd {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-alt);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-text);
  }
  details summary::-webkit-details-marker { display: none; }
  details summary::marker { content: ''; }
  @media (max-width: 358px) {
    .tr-btn { padding: 10px 6px; min-height: 56px; }
    .tr-btn-icon { width: 18px; height: 18px; }
    .tr-btn-label { font-size: 0.6875rem; }
  }
</style>

<script is:inline>
(function () {
  var input = document.getElementById('tr-input');
  var charCount = document.getElementById('tr-char-count');
  var clearBtn = document.getElementById('tr-clear-btn');
  var copyBtn = document.getElementById('tr-copy-btn');
  var emptyState = document.getElementById('tr-empty');
  var resultWrap = document.getElementById('tr-result-wrap');
  var resultEl = document.getElementById('tr-result');
  var resultCount = document.getElementById('tr-result-count');
  var activeModeEl = document.getElementById('tr-active-mode');
  var statusEl = document.getElementById('tr-status');
  var buttons = document.querySelectorAll('.tr-btn');
  var currentResult = '';
  var activeBtn = null;
  var activeMode = null;

  var modeLabels = {
    chars: 'Reverse Chars', words: 'Reverse Words', lines: 'Reverse Lines',
    wordschars: 'Words + Chars', mirror: 'Mirror Text', upsidedown: 'Upside Down',
    eachword: 'Each Word', eachline: 'Each Line', shufflewords: 'Shuffle Words',
    shufflechars: 'Shuffle Chars', interleave: 'Interleave', scramble: 'Scramble Words'
  };

  var mirrorMap = {
    'a':'ɒ','b':'d','c':'ɔ','d':'b','e':'ɘ','f':'ꟻ','g':'ǫ','h':'ʜ','i':'i','j':'ꞁ',
    'k':'k','l':'l','m':'m','n':'n','o':'o','p':'q','q':'p','r':'ɿ','s':'s','t':'t',
    'u':'u','v':'v','w':'w','x':'x','y':'y','z':'z','A':'A','B':'ꓭ','C':'Ɔ','D':'ꓷ',
    'E':'Ǝ','F':'ꟻ','G':'Ꭾ','H':'H','I':'I','J':'Ⴑ','K':'K','L':'⅃','M':'M','N':'N',
    'O':'O','P':'ꟼ','Q':'Ọ','R':'Я','S':'S','T':'T','U':'U','V':'V','W':'M','X':'X',
    'Y':'Y','Z':'Z','!':'!','?':'⸮','.':'.','"':'„',"'":',','(':')',')':'(',
    '[':']',']':'[','{':'}','}':'{','<':'>','>':'<','&':'&','@':'@',' ': ' '
  };

  var upsideDownMap = {
    'a':'ɐ','b':'q','c':'ɔ','d':'p','e':'ǝ','f':'ɟ','g':'ƃ','h':'ɥ','i':'ᴉ','j':'ɾ',
    'k':'ʞ','l':'l','m':'ɯ','n':'u','o':'o','p':'d','q':'b','r':'ɹ','s':'s','t':'ʇ',
    'u':'n','v':'ʌ','w':'ʍ','x':'x','y':'ʎ','z':'z','A':'∀','B':'ᗺ','C':'Ɔ','D':'ᗡ',
    'E':'Ǝ','F':'ᖷ','G':'ᗺ','H':'H','I':'I','J':'ſ','K':'ʞ','L':'˥','M':'W','N':'N',
    'O':'O','P':'Ԁ','Q':'Ò','R':'ᴚ','S':'S','T':'┴','U':'∩','V':'Λ','W':'M','X':'X',
    'Y':'⅄','Z':'Z','1':'Ɩ','2':'ᄅ','3':'Ɛ','4':'ㄣ','5':'ϛ','6':'9','7':'ㄥ','8':'8',
    '9':'6','0':'0','.':'˙',',':'\'','\'':',','"':'„','!':'¡','?':'¿','(':')',')':'(',
    '[':']',']':'[','{':'}','}':'{','<':'>','>':'<','&':'⅋','_':'‾',' ': ' '
  };

  function shuffleArray(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    }
    return arr;
  }

  function reverseString(str) {
    return str.split('').reverse().join('');
  }

  function applyMirror(str) {
    var result = '';
    for (var i = 0; i < str.length; i++) {
      result += (mirrorMap[str[i]] || str[i]);
    }
    return result;
  }

  function applyUpsideDown(str) {
    var result = '';
    for (var i = str.length - 1; i >= 0; i--) {
      result += (upsideDownMap[str[i]] || str[i]);
    }
    return result;
  }

  function interleave(str) {
    var arr = str.split('');
    var n = arr.length;
    var result = [];
    for (var i = 0; i < Math.ceil(n / 2); i++) {
      result.push(arr[i] || '');
      if (n - 1 - i > i) result.push(arr[n - 1 - i] || '');
    }
    return result.join('');
  }

  function scrambleWord(word) {
    if (word.length <= 3) return word;
    var first = word[0];
    var last = word[word.length - 1];
    var middle = word.slice(1, -1).split('');
    return first + shuffleArray(middle).join('') + last;
  }

  function process(text, mode) {
    switch (mode) {
      case 'chars':
        return reverseString(text);
      case 'words':
        return text.split(/(\s+)/).reverse().join('');
      case 'lines':
        return text.split('\n').reverse().join('\n');
      case 'wordschars':
        return text.split('\n').map(function (line) {
          return line.split(/\s+/).filter(function(w){return w;}).map(reverseString).reverse().join(' ');
        }).join('\n');
      case 'mirror':
        return applyMirror(text);
      case 'upsidedown':
        return applyUpsideDown(text);
      case 'eachword':
        return text.split(/(\s+)/).map(function (w) {
          return /\s/.test(w) ? w : reverseString(w);
        }).join('');
      case 'eachline':
        return text.split('\n').map(reverseString).join('\n');
      case 'shufflewords':
        return shuffleArray(text.split(/(\s+)/)).join('');
      case 'shufflechars':
        return shuffleArray(text.split('')).join('');
      case 'interleave':
        return interleave(text);
      case 'scramble':
        return text.split(/(\s+)/).map(function (w) {
          return /\s/.test(w) ? w : scrambleWord(w);
        }).join('');
      default:
        return text;
    }
  }

  function updateCharCount() {
    charCount.textContent = input.value.length + ' chars';
  }

  function showResult(text, mode) {
    currentResult = text;
    resultEl.textContent = text;
    emptyState.classList.add('hidden');
    resultWrap.classList.remove('hidden');
    resultWrap.classList.add('animate-slide-up');
    resultCount.textContent = text.length + ' characters';
    activeModeEl.textContent = modeLabels[mode] || '';
    copyBtn.disabled = false;
    statusEl.textContent = '✓ Reversed';
    statusEl.classList.add('text-green-600', 'dark:text-green-400');
    setTimeout(function () {
      resultWrap.classList.remove('animate-slide-up');
    }, 500);
  }

  function clearResult() {
    currentResult = '';
    resultEl.textContent = '';
    emptyState.classList.remove('hidden');
    resultWrap.classList.add('hidden');
    copyBtn.disabled = true;
    statusEl.textContent = '';
    activeModeEl.textContent = '';
    if (activeBtn) { activeBtn.classList.remove('active'); activeBtn = null; }
    activeMode = null;
  }

  function runMode(mode, btn) {
    var text = input.value;
    if (!text.trim()) {
      input.focus();
      input.classList.add('ring-2', 'ring-brand-500/30');
      setTimeout(function () { input.classList.remove('ring-2', 'ring-brand-500/30'); }, 600);
      return;
    }
    if (activeBtn) activeBtn.classList.remove('active');
    btn.classList.add('active');
    activeBtn = btn;
    activeMode = mode;
    var result = process(text, mode);
    showResult(result, mode);
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      runMode(btn.getAttribute('data-mode'), btn);
    });
  });

  clearBtn.addEventListener('click', function () {
    input.value = '';
    updateCharCount();
    clearResult();
    input.focus();
  });

  copyBtn.addEventListener('click', function () {
    if (!currentResult) return;
    navigator.clipboard.writeText(currentResult).then(function () {
      var orig = copyBtn.innerHTML;
      copyBtn.innerHTML = '<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg><span>Copied!</span>';
      copyBtn.classList.add('!bg-green-500');
      setTimeout(function () {
        copyBtn.innerHTML = orig;
        copyBtn.classList.remove('!bg-green-500');
      }, 2000);
    });
  });

  input.addEventListener('input', function () {
    updateCharCount();
    if (activeBtn && activeMode) {
      var result = process(input.value, activeMode);
      showResult(result, activeMode);
    }
  });

  document.addEventListener('keydown', function (e) {
    if (e.ctrlKey && e.shiftKey && e.key === 'C') {
      e.preventDefault();
      if (!copyBtn.disabled) copyBtn.click();
    } else if (e.ctrlKey && e.shiftKey && e.key === 'K') {
      e.preventDefault();
      clearBtn.click();
    } else if (e.ctrlKey && e.key === 'i') {
      e.preventDefault();
      input.focus();
    } else if (e.ctrlKey && e.key === 'd') {
      e.preventDefault();
      if (activeMode === 'shufflewords' || activeMode === 'shufflechars' || activeMode === 'scramble') {
        if (activeBtn) activeBtn.click();
      }
    } else if (e.ctrlKey && !e.shiftKey) {
      var map = { r: 'chars', w: 'words' };
      var m = map[e.key.toLowerCase()];
      if (m && document.activeElement !== input) {
        e.preventDefault();
        var b = document.querySelector('.tr-btn[data-mode="' + m + '"]');
        if (b) b.click();
      }
    }
  });

  updateCharCount();
})();
</script>
