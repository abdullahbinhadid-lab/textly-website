---

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout
  title="Contact Textly"
  description="Get in touch with the Textly team. We'd love to hear your feedback, feature requests, and bug reports."
  canonical="/contact"
  hideContactForm={true}
>
  <!-- Hero section -->
  <section class="relative overflow-hidden pt-16 pb-12 sm:pt-24 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute left-[12%] top-[15%] h-72 w-72 rounded-full bg-brand-500/15 blur-3xl animate-float dark:bg-brand-500/8"></div>
      <div class="absolute right-[10%] top-[20%] h-64 w-64 rounded-full bg-cyan-500/15 blur-3xl animate-float-slow dark:bg-cyan-500/8"></div>
    </div>
    <div class="container-narrow relative z-10 text-center">
      <div class="mb-4 flex justify-center">
        <span class="badge-brand">Contact</span>
      </div>
      <h1 class="text-h1 font-extrabold tracking-tight xs:text-[2rem]">
        <span class="text-gradient">Get in Touch</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-body-lg text-txt-muted xs:text-small">
        Have a feature request, bug report, or just want to say hi? We'd love to hear from you.
      </p>
    </div>
  </section>

  <div class="container-narrow pb-12">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-5">
      <!-- Contact info sidebar -->
      <div class="lg:col-span-2 space-y-4">
        <div class="card-feature p-6">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          </div>
          <h3 class="font-semibold text-body">Email Us</h3>
          <p class="mt-1 text-small text-txt-muted leading-relaxed">Drop us a line anytime. We read every message.</p>
          <div class="mt-3 flex flex-col gap-1">
            <a href="mailto:info@toolly.site" class="text-small font-medium text-brand-600 hover:underline dark:text-brand-300">info@toolly.site</a>
            <a href="mailto:tool@toolly.site" class="text-small font-medium text-brand-600 hover:underline dark:text-brand-300">tool@toolly.site</a>
          </div>
        </div>
        <div class="card-feature p-6">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          </div>
          <h3 class="font-semibold text-body">Social</h3>
          <p class="mt-1 text-small text-txt-muted leading-relaxed">Follow us for updates and new tools.</p>
          <span class="mt-3 inline-block text-small font-medium text-brand-600 dark:text-brand-300">@textlytools</span>
        </div>
        <div class="card-feature p-6">
          <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-semibold text-body">Response Time</h3>
          <p class="mt-1 text-small text-txt-muted leading-relaxed">We typically respond within 48 hours during weekdays.</p>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-3">
        <form id="contact-form" class="card p-6 sm:p-8 space-y-5">
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-small font-medium mb-2">Name</label>
              <input type="text" id="name" name="name" required class="tool-input" style="min-height: auto;" placeholder="Your name" />
            </div>
            <div>
              <label for="email" class="block text-small font-medium mb-2">Email</label>
              <input type="email" id="email" name="email" required class="tool-input" style="min-height: auto;" placeholder="you@example.com" />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-small font-medium mb-2">Subject</label>
            <select id="subject" name="subject" class="tool-select w-full">
              <option value="feedback">Feedback</option>
              <option value="feature">Feature Request</option>
              <option value="bug">Bug Report</option>
              <option value="business">Business Inquiry</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-small font-medium mb-2">Message</label>
            <textarea id="message" name="message" required rows="5" class="tool-textarea" placeholder="Your message..."></textarea>
          </div>

          <button type="submit" class="btn-primary w-full">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            <span>Send Message</span>
          </button>

          <div id="form-success" class="hidden rounded-xl border border-green-300 bg-green-50 p-4 text-small text-green-700 dark:border-green-800 dark:bg-green-900/20 dark:text-green-300">
            <strong>Thank you!</strong> <span id="success-text">Your message has been sent successfully. We'll get back to you soon!</span>
          </div>

          <div id="form-error" class="hidden rounded-xl border border-red-300 bg-red-50 p-4 text-small text-red-700 dark:border-red-800 dark:bg-red-900/20 dark:text-red-300">
            <strong>Oops!</strong> <span id="error-text">Something went wrong. Please try again or email us directly.</span>
          </div>

          <p class="text-center text-tiny text-txt-muted">
            Or email us directly at
            <a href="mailto:info@toolly.site" class="font-medium text-brand-600 hover:underline dark:text-brand-300">info@toolly.site</a>
            &middot;
            <a href="mailto:tool@toolly.site" class="font-medium text-brand-600 hover:underline dark:text-brand-300">tool@toolly.site</a>
          </p>
        </form>
      </div>
    </div>
  </div>

  <div class="container-narrow pb-12">
    <div class="card p-6 text-center">
      <h2 class="text-h4 font-bold mb-2">Looking for something specific?</h2>
      <p class="text-small text-txt-muted mb-4">Check out our FAQ or browse all 28 free text tools.</p>
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a href="/faq" class="btn-secondary px-5 py-2.5 text-small">View FAQ</a>
        <a href="/tools" class="btn-primary px-5 py-2.5 text-small">Browse All Tools</a>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var success = document.getElementById('form-success');
      var errorEl = document.getElementById('form-error');
      var successText = document.getElementById('success-text');
      var errorText = document.getElementById('error-text');
      var submitBtn = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.querySelector('span') ? submitBtn.querySelector('span').textContent = 'Sending...' : null;
        success.classList.add('hidden');
        errorEl.classList.add('hidden');

        var data = {};
        new FormData(form).forEach(function (val, key) { data[key] = val; });
        data.form_type = 'contact';
        data.page_url = window.location.href;

        fetch('/send-mail.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        })
        .then(function (res) { return res.json(); })
        .then(function (result) {
          if (result.success) {
            successText.textContent = result.message;
            success.classList.remove('hidden');
            form.reset();
            submitBtn.style.display = 'none';
          } else {
            errorText.textContent = result.message || 'Something went wrong.';
            errorEl.classList.remove('hidden');
          }
        })
        .catch(function () {
          errorText.textContent = 'Could not connect to the server. Please email us directly at info@toolly.site';
          errorEl.classList.remove('hidden');
        })
        .finally(function () {
          submitBtn.disabled = false;
        });
      });
    })();
  </script>
</BaseLayout>
