---

import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="About Textly — Privacy-First Text Tools"
  description="Learn about Textly, our mission to provide free, privacy-first text tools that run entirely in your browser."
  canonical="/about"
  hideContactForm={true}
>
  <!-- Hero section -->
  <section class="relative overflow-hidden pt-16 pb-12 sm:pt-24 sm:pb-16">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="absolute left-[10%] top-[20%] h-72 w-72 rounded-full bg-brand-500/15 blur-3xl animate-float dark:bg-brand-500/8"></div>
      <div class="absolute right-[15%] top-[10%] h-64 w-64 rounded-full bg-accent-500/15 blur-3xl animate-float-slow dark:bg-accent-500/8"></div>
    </div>
    <div class="container-narrow relative z-10 text-center">
      <div class="mb-4 flex justify-center">
        <span class="badge-brand">About Us</span>
      </div>
      <h1 class="text-h1 font-extrabold tracking-tight xs:text-[2rem]">
        <span class="text-gradient">Textly is on a mission to make text tools private, free, and fast</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-body-lg text-txt-muted xs:text-small">
        We believe text tools should be simple, private, and accessible to everyone — without ads covering the entire screen or your data being shipped to servers.
      </p>
    </div>
  </section>

  <div class="container-narrow space-y-12 pb-8">
    <!-- Our Story -->
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
      <div class="lg:col-span-1">
        <div class="sticky top-24">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow mb-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <h2 class="text-h3 font-bold">Our Story</h2>
        </div>
      </div>
      <div class="lg:col-span-2 space-y-4">
        <div class="card-feature p-6">
          <p class="text-body text-txt-muted leading-relaxed">
            Textly was born out of frustration with existing text tool websites. Most of them are cluttered with ads,
            require you to scroll past banners to see your results, and silently upload your text to their servers.
            We knew we could do better.
          </p>
        </div>
        <div class="card-feature p-6">
          <p class="text-body text-txt-muted leading-relaxed">
            So we built Textly — a suite of 33 essential text tools that run entirely in your browser. No server-side
            processing, no data collection, no signup walls. Just clean, fast, privacy-respecting tools that work.
          </p>
        </div>
      </div>
    </div>

    <div class="section-divider"></div>

    <!-- Our Principles -->
    <div>
      <div class="mb-8">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow mb-4">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h2 class="text-h3 font-bold">Our Principles</h2>
        <p class="mt-2 text-body text-txt-muted max-w-2xl">The core values that guide everything we build.</p>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="card-feature p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600 dark:bg-brand-900/30 dark:text-brand-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-body">Privacy First</h3>
              <p class="mt-1 text-small text-txt-muted leading-relaxed">All processing is client-side. Your text never leaves your browser.</p>
            </div>
          </div>
        </div>
        <div class="card-feature p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-100 text-accent-600 dark:bg-accent-900/30 dark:text-accent-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-body">Free Forever</h3>
              <p class="mt-1 text-small text-txt-muted leading-relaxed">No paywalls, no freemium gates. All tools are 100% free, supported by display ads.</p>
            </div>
          </div>
        </div>
        <div class="card-feature p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600 dark:bg-cyan-900/30 dark:text-cyan-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-body">No Signup</h3>
              <p class="mt-1 text-small text-txt-muted leading-relaxed">No account needed. Open a tool and start using it immediately.</p>
            </div>
          </div>
        </div>
        <div class="card-feature p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600 dark:bg-brand-900/30 dark:text-brand-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-body">Open & Transparent</h3>
              <p class="mt-1 text-small text-txt-muted leading-relaxed">We clearly state what each tool does and how it works.</p>
            </div>
          </div>
        </div>
        <div class="card-feature p-5">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-100 text-accent-600 dark:bg-accent-900/30 dark:text-accent-300">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-body">Accessible</h3>
              <p class="mt-1 text-small text-txt-muted leading-relaxed">Works on all devices, from desktop to 320px phones.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="section-divider"></div>

    <!-- How We Make Money + Technology -->
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="card-feature p-6">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h2 class="text-h4 font-bold mb-3">How We Make Money</h2>
        <p class="text-body text-txt-muted leading-relaxed">
          Textly is supported entirely by display advertising (Google AdSense) and affiliate links to writing tools
          we genuinely recommend. We will never charge for any of our tools, sell your data, or add paywalls.
        </p>
        <p class="text-body text-txt-muted leading-relaxed mt-4">
          Our ads are minimal and non-intrusive — we'd rather have a fast, clean site than one covered in pop-ups.
        </p>
      </div>
      <div class="card-feature p-6">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-brand-gradient text-white shadow-glow">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <h2 class="text-h4 font-bold mb-3">Technology</h2>
        <p class="text-body text-txt-muted leading-relaxed">
          Textly is built with Astro, Tailwind CSS, and TypeScript. The entire site is static — no backend server,
          no database, no API calls for tool processing. Everything you type is processed by JavaScript running
          in your browser. Text to Speech and Speech to Text use the browser's native Web Speech API.
        </p>
      </div>
    </div>
  </div>

  <!-- Quick Links -->
  <div class="container-narrow pb-8">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <a href="/guides" class="card-feature p-5 flex items-center gap-4 transition-all hover:scale-[1.02]">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600 dark:bg-brand-900/30 dark:text-brand-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-body">Tool Guides</h3>
          <p class="text-tiny text-txt-muted">Learn how each tool works step by step</p>
        </div>
      </a>
      <a href="/blog" class="card-feature p-5 flex items-center gap-4 transition-all hover:scale-[1.02]">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-accent-100 text-accent-600 dark:bg-accent-900/30 dark:text-accent-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 0a2 2 0 012 2v8a2 2 0 01-2 2m0-12V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2h12a2 2 0 002-2V8a2 2 0 00-2-2h-2"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-body">Read Our Blog</h3>
          <p class="text-tiny text-txt-muted">Tips, guides, and insights about text tools</p>
        </div>
      </a>
      <a href="/faq" class="card-feature p-5 flex items-center gap-4 transition-all hover:scale-[1.02]">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600 dark:bg-cyan-900/30 dark:text-cyan-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-body">FAQ</h3>
          <p class="text-tiny text-txt-muted">Answers to common questions about our tools</p>
        </div>
      </a>
    </div>
  </div>

  <CTA
    title="Ready to try our tools?"
    description="All 33 tools are free, private, and ready to use right now."
    buttonText="Browse All Tools"
    buttonHref="/#tools"
  />
</BaseLayout>
